#!/usr/bin/env python3
"""oe -- the Overwatch Enforcer command line.

    oe watch                THE COMMAND. Live view of every open session, and it
                            keeps the per-session HTML reports building while it
                            runs. No configuration, nothing to install.
    oe                      same as `oe status`
    oe status               full breakdown of the current (or named) session
    oe report [sid|--last]  build report.html now, print the path
    oe open  [sid|--last]   open that report in a browser
    oe path  [sid|--last]   just print where it is (stable from the session id)
    oe supervise --ensure   start the background writer if it is not up
    oe sessions             table of recent sessions
    oe dashboard            rebuild the cross-session index.html
    oe backfill             build reports for past transcripts
    oe doctor               health check; exits 0 when the primary path is fine
    oe prune [--days N]     drop old residency/events/scratch and VACUUM
                            (counts only; --yes to delete)
    oe reprice              re-extract the pricing table from the CC binary
    oe version              the version -- plus the short commit and whether the
    oe --version            tree is dirty, when this install is a git checkout.
                            The first line of any bug report.

    oe rereads              which files were read again, why, and what it cost
    oe savings              where the spend could have been smaller

    oe find <query>         bm25 slices from the context index (cheaper than Read)
    oe slice <path> [sym]   one symbol / line span, or the file's outline
    oe deps <path>          the import subtree as a ranked slice
    oe index [roots...]     build/refresh that index (incremental)

    oe audit [sid|--all]    scan the written reports for personal data
    oe whois <pseudonym>    which real session is 'session_07'? (local only)
    oe rebuild --all [--purge]
                            regenerate every report through the redaction
                            allowlist; --purge deletes the old artifacts first
    oe account list         per-account spend and how each label was known
    oe account whoami       the label of the account logged in right now
    oe account assign       override a session's label by hand
    oe package [--out DIR]  build the shareable release archive

    oe repair               RESCUE. Diagnose (and with --yes repair) the hook
                            registrations in settings.json, from a plain shell,
                            when Claude Code will not start. Runs bin/oe-repair,
                            which is standalone and imports none of oe/ -- so it
                            still works when the rest of this tree does not.

    oe autostart --install  OPTIONAL. One delimited, guarded line in ~/.zshrc so
    oe autostart --remove   the supervisor is up from the first terminal of the
    oe autostart --status   day. Backed up and zsh -n checked before any write;
                            OE_NO_AUTOSTART=1 disables it without an edit.

    oe install-statusline   OPTIONAL. The one feature that needs a settings.json
    oe uninstall-statusline key, because `statusLine` is Claude Code's only
                            extension point for a row inside its window. Dry run
                            unless you pass --yes.

Every command works from any working directory and with no arguments. Nothing
here touches the network. Nothing writes settings.json except the two
install-statusline commands, and only with --yes; `oe autostart` writes the
shell rc and nothing else.
"""

from __future__ import annotations

# os and sys FIRST, and alone: _bootstrap_redaction() below has to be armed
# before any other import, because an exception raised during one of those
# imports is exactly the traceback this hook exists to scrub.
import os
import sys

# ---------------------------------------------------------------------------
# The excepthook has to be armed BEFORE the first `from oe import ...`, not in
# main().
#
# Anything raised earlier -- while importing the oe modules, or their stdlib
# dependencies -- otherwise reaches CPython's default hook, which prints every
# frame's absolute path plus whatever the message quoted. Import failure is not
# exotic on somebody else's machine -- a stale .pyc, a half-finished upgrade, a
# full disk, the wrong Python -- so it is precisely the traceback a co-worker is
# most likely to paste into a chat.
#
# So: a self-contained bootstrap hook first, replaced by the real one the
# moment oe.redact is importable. It prefers redact.scrub() when that module
# did load (identical output to the real hook), and falls back to its own five
# patterns when the failure was oe.redact itself.
# ---------------------------------------------------------------------------
def _bootstrap_redaction() -> None:
    env = str(os.environ.get("OE_REDACT") or "").strip().lower()
    if "--no-redact" in sys.argv[1:] or env in ("0", "false", "no", "off", "never", "raw"):
        return                                   # explicit opt-out, honoured here too
    if not ("--redact" in sys.argv[1:]
            or env in ("1", "true", "yes", "on", "always", "redact")):
        try:
            # Both, not just stdout: `oe status > out.json` leaves stderr on the
            # terminal, and `oe status 2> err.log` leaves stdout on it. Either
            # redirection means somebody is capturing, and a captured traceback
            # is the artifact this hook exists for. Config's redact_cli=never
            # is deliberately NOT consulted here -- reading it needs oe.paths,
            # which is one of the imports this hook has to survive; the two
            # explicit opt-outs above cover the same intent.
            if sys.stderr.isatty() and sys.stdout.isatty():
                return                           # an operator reading their own machine
        except Exception:
            pass                                 # cannot tell -> redact, the safe way

    import re as _re

    def _fallback(text: str) -> str:
        try:
            # os.path, not pathlib: pathlib is imported below this hook, and
            # a hook that needs an import that failed is no hook at all.
            home = os.path.expanduser("~").rstrip("/")
            if len(home) > 3:
                text = _re.sub(_re.escape(home) + r"(?=/|\b)", "~", text)
            text = _re.sub(r"/(home|Users)/[A-Za-z0-9._-]+", r"/\1/<user>", text)
            for name in (os.environ.get("USER"), os.environ.get("LOGNAME"),
                         os.path.basename(home)):
                name = str(name or "")
                if len(name) >= 4:
                    text = _re.sub(_re.escape(name), "<user>", text, flags=_re.I)
            text = _re.sub(r"[\w.+-]+@[\w-]+\.[\w.]{2,}", "<account>", text)
            text = _re.sub(r"\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-"
                           r"[0-9a-f]{4}-[0-9a-f]{12}\b", "<id>", text, flags=_re.I)
            return text
        except Exception:
            return "<redaction failed; traceback suppressed>"

    def _hook(exc_type, exc, tb):
        try:
            import traceback as _tb
            text = "".join(_tb.format_exception(exc_type, exc, tb))
            scrub = _fallback
            module = sys.modules.get("oe.redact")
            if module is not None and hasattr(module, "scrub"):
                scrub = module.scrub                     # the real one, once it exists
            sys.stderr.write(scrub(text))
            sys.stderr.flush()
        except Exception:
            sys.stderr.write("<redaction failed; traceback suppressed>\n")

    _hook._oe_scrubbed = True                            # install_cli_redaction() defers to this
    sys.excepthook = _hook


_bootstrap_redaction()

import argparse  # noqa: E402
import json  # noqa: E402
import shutil  # noqa: E402
import subprocess  # noqa: E402
import time  # noqa: E402
from datetime import datetime, timezone  # noqa: E402
from pathlib import Path  # noqa: E402
from typing import Any, Dict, List, Optional, Sequence, Tuple  # noqa: E402

# bin/oe -> the install root is one level up. Derived from __file__ (resolved,
# so a symlinked bin/oe on PATH still finds the real tree) rather than written
# as a literal, which is correct on one machine and wrong on every other.
INSTALL_ROOT = os.environ.get("OE_INSTALL_ROOT") or str(
    Path(__file__).resolve().parent.parent)
if INSTALL_ROOT not in sys.path:
    sys.path.insert(0, INSTALL_ROOT)



try:
    from oe import accounts as accounts_mod  # noqa: E402
    from oe import paths, pricing  # noqa: E402
    from oe import redact as redact_mod  # noqa: E402
    from oe import ledger as ledger_mod  # noqa: E402
except ModuleNotFoundError as _exc:  # pragma: no cover -- the oe/ package is gone
    # The one failure this file must not answer with a bare traceback.
    #
    # If the oe/ package is gone, EVERY subcommand here is gone with it --
    # including `oe doctor`, which is what a user reaches for when Claude Code
    # has stopped starting. A bare ModuleNotFoundError names a Python module
    # and nothing else: not what broke, not what it costs, and above all not
    # bin/oe-repair, which sits in this same directory, imports nothing from
    # oe/ precisely so that it survives this, and is the only thing that can
    # put settings.json back. A rescue tool nobody can find has not rescued
    # anyone, so its name goes in the failure that sends you looking.
    import os as _os
    import sys as _sys
    _root = INSTALL_ROOT
    _repair = _os.path.join(_root, "bin", "oe-repair")
    print(f"oe: the oe/ package is missing or unimportable under {_root} "
          f"({_exc.__class__.__name__}: {_exc}).", file=_sys.stderr)
    print("    No `oe` subcommand can run until it is restored -- reinstall or "
          "re-clone the checkout.", file=_sys.stderr)
    if _os.path.exists(_repair):
        print("", file=_sys.stderr)
        print("    If Claude Code itself is failing on a hook, repair its "
              "settings.json first.", file=_sys.stderr)
        print("    That tool is standalone and needs none of this package:",
              file=_sys.stderr)
        print(f"      python3 {_repair}            (diagnose; nothing is written)",
              file=_sys.stderr)
        print(f"      python3 {_repair}      (diagnoses; this build never writes)",
              file=_sys.stderr)
    _sys.exit(2)

# ---------------------------------------------------------------------------
# presentation helpers
# ---------------------------------------------------------------------------

_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _supports_color(stream=None) -> bool:
    stream = stream or sys.stdout
    try:
        return stream.isatty() and not os.environ.get("NO_COLOR")
    except Exception:
        return False


def c(text: str, code: str, enabled: Optional[bool] = None) -> str:
    """Wrap text in an SGR code, unless colour is off."""
    on = _COLOR if enabled is None else enabled
    return f"\x1b[{code}m{text}\x1b[0m" if on else text


DIM = "38;5;244"
BOLD = "1"
WHITE = "38;5;255"
BLUE = "38;5;111"
CYAN = "38;5;80"
GREEN = "38;5;114"
AMBER = "38;5;214"
ORANGE = "38;5;208"
RED = "38;5;203"
MAGENTA = "38;5;176"
GREY = "38;5;240"


def _emit_json(payload: Any, projector) -> Any:
    """Apply an artifact projector to a --json payload when redaction is on.

    The stream scrubber in oe/redact.py removes identifiers by SHAPE, which is
    the right tool for a rendered table and the wrong one for a JSON dump: a
    prompt, a session title and a shell command line are prose, and prose has
    no shape to match. Every --json emitter is therefore routed through the
    SAME field-by-field allowlist that builds the artifacts, under the same
    policy that governs the scrubber -- so `oe status --json | tee bug.json`
    and `<reports>/sessions/<id>/data.json` contain exactly the same fields.

    A terminal (or --no-redact) still gets the raw payload: that operator is
    reading their own machine, which is the case the detail exists for.
    """
    try:
        if not redact_mod.cli_redaction_enabled(sys.stdout):
            return payload
        return projector(payload)
    except Exception:
        # Never emit the raw payload because the projector failed -- that is the
        # one direction this helper must not fail in.
        return {"error": "redaction failed; payload suppressed",
                "hint": "re-run at a terminal, or with --no-redact"}


def pct_color(pct: float) -> str:
    if pct >= 90:
        return RED
    if pct >= 75:
        return ORANGE
    if pct >= 55:
        return AMBER
    return GREEN


def humanize_tokens(value: Optional[float]) -> str:
    value = float(value or 0)
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.2f}B"
    if value >= 1_000_000:
        return f"{value / 1_000_000:.2f}M"
    if value >= 10_000:
        return f"{value / 1000:.1f}k"
    if value >= 1000:
        return f"{value / 1000:.2f}k"
    return f"{int(value)}"


def money(value: Optional[float], places: int = 2, known: bool = True,
          estimate: bool = False) -> str:
    # known=False means "we did not measure this", which is not the same claim as
    # "$0.00". A tail scan of a transcript with no cost-state line knows nothing
    # about its dollars; printing a zero there silently under-reports the rollup.
    if not known:
        return "-"
    value = float(value or 0)
    text = f"${value:.4f}" if value and abs(value) < 0.01 else f"${value:,.{places}f}"
    # A leading tilde is the whole difference between "Claude Code billed this"
    # and "we measured it from the transcript, which is missing the output
    # tokens a sidechain never writes back". The two must not print alike.
    return ("~" + text) if estimate else text


def row_money(row: Dict[str, Any], places: int = 2) -> str:
    """Format a scan row's cost carrying its own provenance."""
    return money(row.get("cost_usd"), places,
                 known=row.get("cost_known", True),
                 estimate=bool(row.get("cost_is_estimate")))


def _calls_text(row: Dict[str, Any]) -> str:
    """'23+' when the count came from a tail sample rather than a full parse."""
    calls = int(row.get("calls") or 0)
    return f"{calls}+" if row.get("calls_partial") else str(calls)


def _source_tag(row: Dict[str, Any]) -> str:
    """Where this row's dollars came from, in one word.

    The live view has to be able to say "this is Claude Code's own number" or
    "this is ours, and it is a floor" -- a session that has not written a
    cost-state checkpoint yet has no reported figure at all, and rendering that
    as $0.00 is a claim the data does not support.
    """
    if row.get("cost_pending"):
        return "[queued]"
    source = row.get("cost_source")
    if source == "reported":
        return "[billed]"
    if source == "mixed":
        return "[billed+measured]"
    if source == "computed":
        return "[measured]"
    return ""


def duration(seconds: Optional[float]) -> str:
    seconds = int(seconds or 0)
    if seconds <= 0:
        return "-"
    hours, rest = divmod(seconds, 3600)
    minutes, secs = divmod(rest, 60)
    if hours:
        return f"{hours}h{minutes:02d}m"
    if minutes:
        return f"{minutes}m{secs:02d}s"
    return f"{secs}s"


def ago(stamp: Optional[float]) -> str:
    if not stamp:
        return "-"
    delta = max(0, time.time() - float(stamp))
    if delta < 60:
        return f"{int(delta)}s ago"
    if delta < 3600:
        return f"{int(delta // 60)}m ago"
    if delta < 86400:
        return f"{int(delta // 3600)}h ago"
    return f"{int(delta // 86400)}d ago"


def bar(pct: float, width: int = 28, colour: bool = True) -> str:
    """A block-drawing meter. Uses eighth-blocks so a 1% move is visible."""
    pct = max(0.0, min(100.0, float(pct or 0)))
    total_eighths = int(round(pct / 100.0 * width * 8))
    full, remainder = divmod(total_eighths, 8)
    body = "█" * full
    if remainder and full < width:
        body += " ▏▎▍▌▋▊▉"[remainder]
    body = body.ljust(width, " ")
    if not colour or not _COLOR:
        return "[" + body.replace(" ", ".") + "]"
    filled = body[: full + (1 if remainder and full < width else 0)]
    empty = body[len(filled):]
    return (c("│", GREY) + c(filled, pct_color(pct))
            + c("░" * len(empty), GREY) + c("│", GREY))


def term_size() -> tuple:
    """The REAL size of the terminal, never a wider one.

    A generous floor is display-corrupting, not a nicety. The frame builder is
    handed `width`, `_fit()` clips every line to exactly that, and the painter
    repaints from HOME assuming one built line occupies one screen row. Claim 60
    columns in a 40-column pane and every line wraps onto two rows: a frame
    taller than the window means each redraw scrolls the top off, a few rows per
    frame, until the header and the whole live-session block have been pushed out
    of view. The floor of 20 only keeps the arithmetic below sane; that narrow it
    is terse, but stable, and the dollars are still on screen.

    The same applies to the row count, for the same reason: the painter writes
    `height - 1` lines, so a floor of 10 in an 8-row pane writes two rows too
    many and scrolls on every redraw. Below the footer's own three lines the view
    has nothing left to show, but it stays still instead of tearing.

    A size of 0 is not a narrow terminal, it is "this pty has no window size" --
    `script`, some CI runners and a few ssh setups report exactly that, and
    shutil only substitutes its fallback when the ioctl RAISES, not when it
    answers 0. Honouring a literal 0 would paint nothing at all, so 0 means
    unknown and takes the fallback; a real measurement is always taken at face
    value.
    """
    try:
        size = shutil.get_terminal_size((100, 30))
        columns = size.columns if size.columns > 0 else 100
        lines = size.lines if size.lines > 0 else 30
        return max(20, columns), max(1, lines)
    except Exception:
        return 100, 30


def clip(text: str, width: int) -> str:
    text = str(text or "")
    if len(text) <= width:
        return text
    return text[: max(1, width - 1)] + "…"


def clip_left(text: str, width: int) -> str:
    """Trim a PATH from the left, AFTER redacting it.

    The tail (session id, filename) is what tells two report paths apart; the
    shared prefix is what does not.

    The order is the whole point. The stream scrubber that enforces the CLI
    redaction policy sees only what is printed, and every one of its path rules
    is anchored at the LEFT -- `$HOME`, `/home/<name>`, the project slug. Clip
    first and that anchor is the part thrown away, so the rule cannot fire and
    the surviving tail is printed verbatim: `oe rereads` printed the tail of a
    real account name, straight after the ellipsis, in its DEFAULT redacted
    output, and `oe watch`'s footer printed intermediate directory names the
    `~` rewrite would have hidden. Whether it leaked at all depended on where
    the ellipsis happened to land, which is why it survived several passes --
    and why the fix belongs in the clipper rather than in each caller.

    Scrubbing here as well as on the stream is deliberate: the rules are
    idempotent (their outputs -- `~`, `<user>`, `project_NN` -- match none of
    their own patterns), and doing it at the one place that destroys the left
    anchor is cheaper to keep right than remembering the order at each call.
    """
    text = str(text or "")
    if _redacting():
        try:
            text = redact_mod.scrub(text)
        except Exception:
            # scrub() already degrades to a placeholder rather than raising;
            # if even that fails, print nothing rather than the raw path.
            return "<redaction failed; output suppressed>"
    if len(text) <= width:
        return text
    return "…" + text[-max(1, width - 1):]


def _redacting() -> bool:
    """Is the CLI redaction policy active for this run?"""
    try:
        return redact_mod.cli_redaction_enabled(sys.stdout)
    except Exception:
        return False


def short_sid(session_id: str) -> str:
    """The 8-char id prefix -- or the report pseudonym when redacting.

    scrub() cannot help here: it matches whole uuids, and by the time a
    truncated '718293a4' reaches the stream there is nothing left to recognise.
    The fix has to be at the point the value is FORMATTED, which is here.
    """
    text = str(session_id or "")
    if _redacting() and text:
        try:
            entry = (redact_mod._load_map().get("sessions") or {}).get(text)
            name = (entry or {}).get("pseudonym") if isinstance(entry, dict) else None
            if name:
                return str(name)
        except Exception:
            pass
    return text[:8]


def private(text: Any, placeholder: str = "-") -> str:
    """Free text that is a user's own words (a session title, a prompt).

    A title IS the prompt someone typed: customer names, ticket subjects,
    filenames. The reports have never carried one; the terminal did, so when
    output is heading somewhere it can be shared, it says nothing at all rather
    than something patterned. Not scrub()-able -- prose has no shape to match.
    """
    return placeholder if _redacting() else str(text or "")


def rule(width: int, label: str = "") -> str:
    if label:
        head = "── " + label + " "
        return c(head + "─" * max(0, width - len(head)), GREY)
    return c("─" * width, GREY)


# ---------------------------------------------------------------------------
# session resolution
# ---------------------------------------------------------------------------


def _rows(active_within: Optional[int] = None) -> List[Dict[str, Any]]:
    try:
        return ledger_mod.scan_sessions(active_within_seconds=active_within)
    except Exception as exc:  # a broken corpus must not kill the CLI
        print(c(f"scan failed: {exc}", RED), file=sys.stderr)
        return []


# Colours are keyed by ROLE, not by a fixed set of names: labels are allocated
# per machine and renameable, so an unknown one gets a stable colour of its own
# rather than falling through to the "we do not know" grey that means something.
_ACCOUNT_PALETTE = (GREEN, BLUE, MAGENTA, CYAN)
ACCOUNT_COLOUR = {"unknown": GREY}


def account_colour(label: Any) -> str:
    text = str(label or "unknown")
    if text in ACCOUNT_COLOUR:
        return ACCOUNT_COLOUR[text]
    order = [n for n in accounts_mod.known_labels() if n != "unknown"]
    try:
        return _ACCOUNT_PALETTE[order.index(text) % len(_ACCOUNT_PALETTE)]
    except ValueError:
        return GREY


def account_cell(row: Dict[str, Any], width: int = 10) -> str:
    """The label, coloured, with a '?' when the provenance is only a guess.

    Never the address -- that is PII and stays in state. The mark is a
    character, not just a colour, so it survives a pipe: 'work' inferred from a
    heuristic and 'work' read out of a transcript are different claims and the
    column has to say which one it is showing.
    """
    label = str(row.get("account_label") or "unknown")
    guess = accounts_mod.is_guess(row.get("account_source"))
    text = (label + "?") if guess else label
    return c(f"{text[:width]:<{width}}", AMBER if guess else account_colour(label))


def apply_account_filter(rows: List[Dict[str, Any]], wanted: Optional[str]
                         ) -> Optional[List[Dict[str, Any]]]:
    """Filter by label, or None when the argument names no label (already
    reported on stderr, so the caller just exits)."""
    if not wanted:
        return rows
    label = accounts_mod.normalise_label(wanted)
    if label is None:
        print(c(f"unknown account '{wanted}'; expected one of "
                + ", ".join(accounts_mod.LABELS), RED), file=sys.stderr)
        return None
    return accounts_mod.filter_rows(rows, label)


def resolve_transcript(selector: Optional[str]) -> Optional[Path]:
    """A session id, a unique id prefix, a transcript path, or the newest session."""
    if selector and selector not in ("--last", "last", "current"):
        candidate = Path(selector)
        if candidate.is_file():
            return candidate
        found = paths.find_transcript(selector)
        if found:
            return found
        matches = [r for r in _rows() if str(r["session_id"]).startswith(selector)]
        if len(matches) == 1:
            return Path(matches[0]["transcript_path"])
        if len(matches) > 1:
            print(c(f"'{selector}' matches {len(matches)} sessions:", AMBER), file=sys.stderr)
            for row in matches[:10]:
                print("  " + row["session_id"], file=sys.stderr)
            return None
        print(c(f"no session matches '{selector}'", RED), file=sys.stderr)
        return None
    rows = _rows()
    if not rows:
        return None
    return Path(rows[0]["transcript_path"])


def live_snapshot(session_id: str) -> Dict[str, Any]:
    """The watcher's cached numbers, if it left any. Schema-tolerant on purpose:
    this file belongs to the watcher and the CLI only borrows from it."""
    try:
        path = paths.live_snapshot_path(session_id)
        raw = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(raw, dict):
            raw["_age_seconds"] = time.time() - path.stat().st_mtime
            return raw
    except Exception:
        pass
    return {}


def _pick(source: Dict[str, Any], *names, default=None):
    for name in names:
        if name in source and source[name] is not None:
            return source[name]
        nested = source.get("context_window")
        if isinstance(nested, dict) and name in nested and nested[name] is not None:
            return nested[name]
        nested = source.get("totals")
        if isinstance(nested, dict) and name in nested and nested[name] is not None:
            return nested[name]
    return default


# ---------------------------------------------------------------------------
# oe status
# ---------------------------------------------------------------------------


def _account_rollup_lines(rows: List[Dict[str, Any]], width: int) -> List[str]:
    """The per-account rollup, as terminal lines. Label + provenance, no address."""
    table = accounts_mod.rollup(rows)
    lines = [rule(width, "accounts")]
    header = (f"  {'ACCOUNT':<10}{'SESSIONS':>9}{'CALLS':>9}{'TOKENS':>10}"
              f"{'SPEND':>12}   KNOWN FROM")
    lines.append(c(header, DIM))
    for label in accounts_mod.LABELS:
        bucket = table.get(label) or {}
        if not bucket.get("sessions"):
            continue
        sources = ", ".join(
            f"{name} {count}" for name, count in
            sorted(bucket.get("sources", {}).items(),
                   key=lambda kv: accounts_mod.SOURCE_RANK.get(kv[0], 99)))
        unpriced = bucket.get("unpriced") or 0
        note = c(f"  ({unpriced} unpriced)", AMBER) if unpriced else ""
        lines.append(
            "  " + c(f"{label:<10}", account_colour(label))
            + f"{bucket['sessions']:>9}{bucket['calls']:>9}"
            + f"{humanize_tokens(bucket['total_tokens']):>10}"
            + f"{money(bucket['cost_usd'], estimate=bucket.get('estimate')):>12}"
            + "   " + c(sources, DIM) + note)
    return lines



def _residency_block(data: Dict[str, Any], totals: Dict[str, Any], width: int) -> None:
    """What the window costs to KEEP, as opposed to what it cost to fill.

    Every request re-sends the whole prefix, so a session's bill is
    prefix_size x requests -- the one term the console never showed. The table
    above says how many dollars went on cache reads; it cannot say whether that
    was one enormous request or a thousand ordinary ones, and those call for
    opposite responses.

    Deliberately NOT here: the hit ratio and the cache-read share of spend.
    Both already print, further down, as insights. A second copy of a number is
    not a second piece of information.

    Every figure is derived from the session in front of it. Nothing in this
    block is a threshold, a target, or a figure measured somewhere else.
    """
    if not totals.get("cache_read_tokens"):
        return
    origins = data.get("by_origin") or {}
    # by_origin keys non-main rows as "origin:agent_type", so there is no
    # "subagent" row to read; "main" is the only fixed name. Agent spend is
    # therefore the REMAINDER, which also folds in the workflow origin -- hence
    # "agent windows" below, never "subagents".
    main = origins.get("main") or {}
    main_read_usd = float(main.get("cache_read_usd") or 0.0)
    main_read_tokens = int(main.get("cache_read_tokens") or 0)
    main_calls = int(main.get("calls") or 0)
    growth = data.get("context_growth") or {}
    window = data.get("context_window") or {}
    lines = []

    if main_calls and main_read_usd > 0:
        lines.append(("per request",
                      money(main_read_usd / main_calls, places=4, estimate=True),
                      f"{main_calls:,} requests re-sent your window"))

    # Median, not mean: one fan-out turn of several hundred requests would
    # otherwise set the figure for every ordinary turn. Same reasoning, and the
    # same statistic, as tokens_per_turn in context_growth().
    turn_costs = sorted(float(row.get("main_cache_read_usd") or 0.0)
                        for row in (data.get("by_turn") or [])
                        if row.get("index", -1) >= 0
                        and (row.get("calls") or 0) - (row.get("subagent_calls") or 0) > 0)
    # Under three turns there is no middle to take, and "median over 1" is a
    # sentence that describes nothing.
    if len(turn_costs) >= 3:
        middle = len(turn_costs) // 2
        median = (turn_costs[middle] if len(turn_costs) % 2
                  else (turn_costs[middle - 1] + turn_costs[middle]) / 2.0)
        if median > 0:
            lines.append(("per message", money(median, places=4, estimate=True),
                          f"median of your {len(turn_costs)} turns"))

    # The marginal figure: what the NEXT request pays before it does any work.
    # Priced at this session's own realised main-loop rate rather than from the
    # pricing table, so it already carries the geo premium, a fast-mode tier
    # override and any mid-session model switch. It is a floor: if the prefix
    # has fallen out of cache it is re-WRITTEN, which costs more than a read.
    resident = int(window.get("used_tokens") or 0)
    if resident and main_read_tokens:
        rate = main_read_usd / main_read_tokens
        lines.append(("next request",
                      money(resident * rate, places=4, estimate=True),
                      f"{humanize_tokens(resident)} resident right now"))

    fills = int(growth.get("major_resets") or 0)
    if fills and main_read_usd > 0:
        lines.append(("per window fill", money(main_read_usd / (fills + 1), estimate=True),
                      f"average of {fills + 1} fills; it emptied {fills}x"))

    total_read_usd = float(totals.get("cache_read_usd") or 0.0)
    agent_usd = total_read_usd - main_read_usd
    if total_read_usd > 0 and agent_usd / total_read_usd >= 0.05:
        lines.append(("agent windows", money(agent_usd, estimate=True),
                      f"{100.0 * agent_usd / total_read_usd:.0f}% of cache reads "
                      f"were agent context, not yours"))

    if not lines:
        return
    print(rule(width, "cache residency"))
    for label, amount, note in lines:
        print(f"  {label:<15}{amount:>10}  " + c(clip(note, max(10, width - 30)), DIM))
    print()


def cmd_status(args) -> int:
    if getattr(args, "all_accounts", False):
        width, _ = term_size()
        width = min(width, 110)
        rows = _rows()
        print()
        for line in _account_rollup_lines(rows, width):
            print(line)
        who = accounts_mod.whoami()
        print()
        print("  " + c("logged in now: ", DIM)
              + c(str(who["label"]), account_colour(who["label"]))
              + c(f"  ({who['source']})", DIM))
        return 0
    transcript = resolve_transcript(args.session)
    if transcript is None:
        # resolve_transcript() already said WHICH selector missed, on stderr.
        # Claiming "no sessions found under ~/.claude/projects" on top of that
        # is simply false whenever there are sessions and the id was wrong --
        # only say it when the tree really is empty.
        if not _rows():
            print("no sessions found under " + str(paths.PROJECTS_ROOT))
        return 1

    width, _ = term_size()
    width = min(width, 110)

    if args.fast:
        rows = [r for r in _rows() if r["transcript_path"] == str(transcript)]
        row = rows[0] if rows else {}
        print(rule(width, "Overwatch Enforcer (fast)"))
        print(f"  session   {row.get('session_id')}")
        print(f"  project   {paths.project_display(row.get('project') or '')}")
        print(f"  cost      {row_money(row)}  {_source_tag(row)}")
        pct = float(row.get("context_pct") or 0)
        print(f"  context   {bar(pct, 30)} {pct:5.1f}%  "
              f"{humanize_tokens(row.get('context_tokens'))} / {humanize_tokens(row.get('max_tokens'))}")
        return 0

    started = time.perf_counter()
    ledger = ledger_mod.load(transcript, include_subagents=not args.no_subagents)
    data = ledger.to_dict()
    elapsed = time.perf_counter() - started

    if args.json:
        # --json is a MACHINE surface: piped, redirected, attached to a bug
        # report, read by a script. The raw ledger carries the session
        # verbatim -- session.last_prompt, session.cwd, session.git_branch,
        # by_turn[].prompt_preview, and one tools[].target per tool call,
        # which for Bash is the command line itself -- thousands of them in a
        # long session, and each one as long as the command was. The scrubber
        # cannot cover those: it removes identifiers by SHAPE, and a prompt or
        # a shell command is prose. So the JSON goes through the same
        # field-by-field allowlist that builds data.json; only an operator at a
        # terminal, or one who asks with --no-redact, gets the raw payload.
        json.dump(_emit_json(data, redact_mod.redact_payload),
                  sys.stdout, indent=2, default=str)
        print()
        return 0

    session = data["session"]
    totals = data["totals"]
    window = data["context_window"]
    config = paths.load_config()

    print()
    print(rule(width, "Overwatch Enforcer"))
    title = private(session.get("title") or session.get("last_prompt"), "(title hidden)") \
        or "(untitled)"
    print("  " + c(clip(title, width - 4), BOLD))
    _acct = session.get("account_label") or "unknown"
    _asrc = session.get("account_source") or "unknown"
    _aguess = accounts_mod.is_guess(_asrc)
    print("  " + c(f"{session['session_id']}  ", DIM)
          + c(session.get("project_display") or "", BLUE)
          + c(f"  {session.get('git_branch') or ''}", MAGENTA)
          + c(f"  {_acct}", AMBER if _aguess else account_colour(_acct))
          # A guess says so where it is printed, not only in `oe account list`.
          + c(f" ({_asrc}{', unverified' if _aguess else ''})",
              AMBER if _aguess else DIM))
    print()

    authoritative = totals.get("cost_usd_authoritative")
    # Where these dollars came from, in the same vocabulary the live view uses.
    # Printing a bare "$N total" for a number we measured ourselves states
    # a precision the transcript cannot support: sidechain files never persist
    # the final message_delta usage, so a subagent-heavy session reads 8-25%
    # under Claude Code's own figure.
    _cost_src = ("computed" if totals.get("cost_usd_reported") is None
                 else ("reported" if totals.get("cost_fully_reported") else "mixed"))
    _cost_est = _cost_src != "reported" and bool(totals.get("calls"))
    print("  " + c(money(authoritative, estimate=_cost_est), BOLD) + c("  total", DIM)
          + c(f"   {humanize_tokens(totals['total_tokens'])} tokens", WHITE)
          + c(f"   {totals['calls']} API calls", DIM)
          + c(f"   {session['turns']} turns", DIM)
          + c(f"   {duration(session['wall_seconds'])} wall", DIM))
    rate = totals.get("cost_usd_per_hour") or 0
    if rate:
        print("  " + c(f"{money(rate)}/h burn", DIM)
              + c(f"   {money(totals['cost_usd'] / max(1, session['turns']))}/turn", DIM))
    if _cost_src == "computed":
        print("  " + c("[measured] ours, priced from the transcript. A FLOOR: sidechain files "
                       "never write back", DIM))
        print("  " + c("           their final output tokens, so this reads 8-25% under the "
                       "real bill.", DIM))
    elif _cost_src == "mixed":
        print("  " + c(f"[billed+measured] {money(totals.get('cost_usd_reported'))} billed by "
                       f"Claude Code for the runs it", DIM))
        print("  " + c(f"           checkpointed, plus {money(totals.get('cost_usd_uncovered'))} "
                       f"measured over {totals.get('uncovered_calls')} requests no", DIM))
        print("  " + c("           checkpoint covers. The measured part is a floor.", DIM))
    else:
        print("  " + c("[billed] Claude Code's own cost-state total; every request in the "
                       "file is inside it.", DIM))
    print()

    pct = float(window.get("pct") or 0)
    print("  " + c("context", DIM) + " " + bar(pct, min(40, width - 46))
          + c(f" {pct:5.1f}%", pct_color(pct))
          + c(f"  {humanize_tokens(window.get('used_tokens'))} / "
              f"{humanize_tokens(window.get('max_tokens'))}", DIM)
          + c(f"  {pricing.display_name(window.get('model'))}", WHITE))

    growth = data.get("context_growth") or {}
    if growth.get("turns_until_full") is not None:
        print("  " + c(f"          +{humanize_tokens(growth.get('tokens_per_turn'))}/turn"
                       f"  ~{growth.get('turns_until_full')} turns until full", DIM))
    print()

    print(rule(width, "cost by token kind"))
    kinds = [
        ("cache read", totals["cache_read_tokens"], totals["cache_read_usd"]),
        ("cache write 5m", totals["cache_write_5m_tokens"], totals["cache_write_5m_usd"]),
        ("cache write 1h", totals["cache_write_1h_tokens"], totals["cache_write_1h_usd"]),
        ("input", totals["input_tokens"], totals["input_usd"]),
        ("output", totals["output_tokens"], totals["output_usd"]),
    ]
    computed = max(1e-9, totals["cost_usd"])
    for name, tokens, usd in sorted(kinds, key=lambda k: -k[2]):
        share = 100.0 * usd / computed
        print(f"  {name:<15}{humanize_tokens(tokens):>9}  {money(usd):>10}  "
              + bar(share, 18) + c(f" {share:4.1f}%", DIM))
    if totals.get("thinking_tokens"):
        share = 100.0 * totals["thinking_tokens"] / max(1, totals["output_tokens"])
        print("  " + c(f"of which thinking: {humanize_tokens(totals['thinking_tokens'])} "
                       f"({share:.0f}% of output)", DIM))
    print()

    _residency_block(data, totals, width)

    by_model = data["by_model"]
    if by_model:
        print(rule(width, "by model"))
        for row in sorted(by_model.values(), key=lambda r: -r["cost_usd"])[:6]:
            unpriced = c("  UNPRICED", RED) if row.get("unpriced_calls") else ""
            print(f"  {row['display_name']:<12} {row['calls']:>5} calls  "
                  f"{humanize_tokens(row['total_tokens']):>9}  {money(row['cost_usd']):>10}  "
                  + c(row["tier"], DIM) + unpriced)
        print()

    origins = data["by_origin"]
    if len(origins) > 1:
        print(rule(width, "by origin"))
        for name, row in sorted(origins.items(), key=lambda kv: -kv[1]["cost_usd"])[:8]:
            print(f"  {clip(name, 30):<30} {row['calls']:>5} calls  {money(row['cost_usd']):>10}")
        print()

    tools = sorted(data["by_tool"].values(), key=lambda r: -r["count"])
    if tools:
        print(rule(width, "tools"))
        top = int((config.get("insights") or {}).get("top_tools") or 12)
        for row in tools[:top]:
            avg = row.get("avg_duration_ms")
            timing = f"{avg:>6}ms avg" if avg else c("   no timing", DIM)
            print(f"  {clip(row['name'], 26):<26} {row['count']:>5}x  "
                  f"{humanize_tokens(row['est_result_bytes']):>8}B out  {timing}"
                  + (c(f"  {row['errors']} err", RED) if row["errors"] else ""))
        print()

    insights = data.get("insights") or []
    if insights:
        print(rule(width, "insights"))
        for line in insights:
            first = True
            for chunk in _wrap(line, width - 6):
                print(("  " + c("• ", AMBER) if first else "    ") + chunk)
                first = False
        print()

    rec = data.get("reconciliation") or {}
    if rec.get("status") != "unavailable":
        print(rule(width, "reconciliation"))
        delta = rec.get("delta_usd") or 0
        colour = GREEN if abs(rec.get("delta_pct") or 0) < 3 else AMBER
        # The delta is computed over the CHECKPOINTED window only, so the
        # "computed" it is subtracted from has to be that window's figure --
        # printing the whole transcript's total next to it gave three numbers
        # that did not subtract: a window's figure minus a whole-transcript
        # total is a difference between two different things.
        basis = rec.get("computed_usd_covered")
        basis = rec.get("computed_usd") if basis is None else basis
        print(f"  computed {money(basis):>10}   "
              f"claude code {money(rec.get('reported_usd')):>10}   "
              + c(f"delta {money(delta)} ({rec.get('delta_pct', 0):+.2f}%)", colour)
              + (c(f"   (over the checkpointed window; "
                   f"{money(rec.get('computed_usd_uncovered'))} outside it)", DIM)
                 if rec.get("uncovered_calls") else ""))
        for line in (rec.get("diagnosis") or [])[:3]:
            for chunk in _wrap(str(line), width - 6):
                print(c("    " + chunk, DIM))
        print()

    budget = (config.get("budget") or {}).get("session_usd")
    if budget and authoritative:
        share = 100.0 * authoritative / float(budget)
        if share >= float((config.get("budget") or {}).get("warn_pct") or 80):
            print("  " + c(f"budget: {money(authoritative, estimate=_cost_est)} of "
                           f"{money(budget)} ({share:.0f}%)", pct_color(share)))
            print()

    print(c(f"  parsed {data['parse']['files_read']} files / "
            f"{data['parse']['bytes_read'] / 1e6:.1f} MB in {elapsed:.2f}s"
            f"{' - ' + str(data['parse']['bad_lines']) + ' unparsable lines' if data['parse']['bad_lines'] else ''}",
            DIM))
    report_dir = paths.session_report_dir(session["session_id"])
    if (report_dir / "report.html").exists():
        print(c(f"  report: {report_dir / 'report.html'}", DIM))
    print()
    return 0


def _wrap(text: str, width: int) -> List[str]:
    words = str(text).split()
    lines, current = [], ""
    for word in words:
        if len(current) + len(word) + 1 > width and current:
            lines.append(current)
            current = word
        else:
            current = (current + " " + word).strip()
    if current:
        lines.append(current)
    return lines or [""]


# ---------------------------------------------------------------------------
# oe report
# ---------------------------------------------------------------------------


def _write_report(transcript: Path, include_subagents: bool = True) -> Dict[str, Any]:
    ledger = ledger_mod.load(transcript, include_subagents=include_subagents)
    out_dir = paths.session_report_dir(ledger.session_id)
    try:
        from oe import report as report_mod
    except Exception as exc:
        # Still emit the payload everything else is derived from -- redacted and
        # audited, because this path writes into the shareable tree too.
        text = json.dumps(redact_mod.redact_payload(ledger.to_dict()),
                          indent=2, default=str) + "\n"
        redact_mod.guard(text, str(out_dir / "data.json"))
        paths.atomic_write(out_dir / "data.json", text)
        return {"data": out_dir / "data.json", "error": f"oe.report unavailable ({exc})",
                "ledger": ledger}
    written = report_mod.write_report(ledger, out_dir)
    written["ledger"] = ledger
    return written


def _no_session(selector) -> None:
    """Say so, but only for the branch that is otherwise SILENT.

    A non-zero exit with no output is the worst answer a first-run user can
    get, and on a machine that has never run Claude Code `--last` takes exactly
    that branch: resolve_transcript() returns None without a word, because it
    only speaks when a NAMED selector missed. So this fills that one gap and
    stays quiet everywhere resolve_transcript has already spoken.
    """
    if selector and selector not in ("--last", "last", "current"):
        return
    print(c(f"no sessions found under {paths.PROJECTS_ROOT} -- nothing to report "
            "on yet. Run a Claude Code session first.", AMBER), file=sys.stderr)


def cmd_report(args) -> int:
    transcript = resolve_transcript(args.session)
    if transcript is None:
        _no_session(args.session)
        return 1
    started = time.perf_counter()
    try:
        written = _write_report(transcript, include_subagents=not args.no_subagents)
    except redact_mod.RedactionError as exc:
        # A refusal is a decision, not a crash. Unhandled it reaches the user as
        # a bare traceback out of oe/redact.py, which reads like the tool broke
        # rather than like the tool declined -- and the message it carries
        # (which kinds matched, at what offset) is buried under the frames.
        # Still non-zero: `oe backfill` counts a return code, and a blocked
        # session must not be counted as built.
        print(c(str(exc), RED), file=sys.stderr)
        return 1
    elapsed = time.perf_counter() - started
    ledger = written.pop("ledger", None)
    if written.get("error"):
        print(c(written.pop("error"), AMBER), file=sys.stderr)
    for name, path in written.items():
        print(f"{name:>8}  {path}")
    if ledger is not None:
        totals = ledger.totals
        print(c(f"  {totals['calls']} calls, {humanize_tokens(totals['total_tokens'])} tokens, "
                f"{money(totals['cost_usd_authoritative'])} in {elapsed:.2f}s", DIM))
    return 0


# ---------------------------------------------------------------------------
# oe path / oe open -- the report, addressable from the session id alone
# ---------------------------------------------------------------------------


def _report_target(selector: Optional[str]) -> Tuple[Optional[Path], Optional[Path]]:
    """(report.html path, transcript path). Either may be None.

    The path is derived from the session id, never from the presence of a file,
    which is the whole point: a report can be linked in the first second of a
    session, before anything has been written into it. A selector that resolves
    to no transcript at all still yields a path when it looks like an id, so
    `oe path <id>` answers for a session that has not started writing yet.
    """
    from oe import watcher as watcher_mod
    transcript = resolve_transcript(selector)
    if transcript is not None:
        return watcher_mod.report_paths(transcript.stem)["html"], transcript
    if selector and selector not in ("--last", "last", "current"):
        session_id = Path(selector).stem if selector.endswith(".jsonl") else selector
        if paths.safe_session_id(session_id) != "unknown":
            return watcher_mod.report_paths(session_id)["html"], None
    return None, None


def cmd_path(args) -> int:
    """Print where a session's report lives. Creates nothing."""
    target, _transcript = _report_target(args.session)
    if target is None:
        _no_session(args.session)
        return 1
    print(target.parent if args.dir else target)
    return 0


def cmd_open(args) -> int:
    """Open the session's report in a browser, building it when it is missing."""
    from oe import watcher as watcher_mod
    target, transcript = _report_target(args.session)
    if target is None:
        _no_session(args.session)
        return 1
    if not target.exists() and transcript is not None:
        # Publish the placeholder FIRST, so there is something to open even if
        # the real build is slow or fails; write_report() overwrites it.
        watcher_mod.write_skeleton_report(transcript.stem, transcript)
        try:
            _write_report(transcript)
        except Exception as exc:
            print(c(f"report build failed ({type(exc).__name__}); "
                    f"opening the placeholder", AMBER), file=sys.stderr)
    if not target.exists():
        print(c(f"no report at {target}", RED), file=sys.stderr)
        return 1
    print(target)
    if not args.no_browser:
        print(c("  " + _open_externally(target), DIM))
    return 0


# ---------------------------------------------------------------------------
# oe supervise -- the background writer, on demand
# ---------------------------------------------------------------------------


def cmd_supervise(args) -> int:
    """Start / inspect / stop the one background supervisor.

    `--ensure` is the shell-rc entry point: when a supervisor is already up it
    costs one flock probe and returns, which is the common case on every
    terminal after the first.
    """
    from oe import watcher as watcher_mod
    if args.status:
        print(json.dumps(watcher_mod.supervisor_status(), indent=2, default=str))
        return 0
    if args.stop:
        stopped = watcher_mod.stop_supervisor()
        if not args.quiet:
            print("stopped" if stopped else "still running")
        return 0 if stopped else 1
    existing = watcher_mod.supervisor_running()
    if existing:
        if not args.quiet:
            print(f"supervisor already running (pid {existing})")
        return 0
    state = watcher_mod.ensure_supervisor()
    if not args.quiet:
        if state.get("running"):
            print(f"supervisor started (pid {state.get('pid')})")
        else:
            print(c("supervisor did not start", AMBER), file=sys.stderr)
    return 0 if state.get("running") else 1


# ---------------------------------------------------------------------------
# oe autostart -- the opt-in ~/.zshrc one-liner
# ---------------------------------------------------------------------------


def cmd_autostart(args) -> int:
    """Manage the delimited block in the user's shell rc.

    Nothing here touches ~/.claude/settings.json. The shell rc is the only file
    it writes; it is copied aside and the copy verified byte for byte first, the
    candidate is parsed by `zsh -n` before it is put in place, and --remove
    takes the block back out exactly.
    """
    from oe import autostart as autostart_mod
    rc = Path(args.rc) if args.rc else autostart_mod.default_rc()

    if args.remove or args.install:
        try:
            result = (autostart_mod.remove(rc, backup=not args.no_backup) if args.remove
                      else autostart_mod.install(rc, backup=not args.no_backup))
        except Exception as exc:
            # Every refusal in that module is a deliberate one (the backup did
            # not verify, zsh would not parse the result) and leaves the rc
            # untouched. A traceback would bury the sentence that says so.
            print(c(f"refused: {exc}", RED), file=sys.stderr)
            return 1
    else:
        state = autostart_mod.status(rc)
        print(f"rc          {state['rc']}"
              + ("" if state["exists"] else c("  (missing)", RED)))
        print("installed   " + (c("yes", GREEN) if state["installed"] else c("no", DIM))
              + (c(f"  ({state['blocks']} blocks)", AMBER) if state["blocks"] > 1 else "")
              + ("" if not state["installed"] or state["current"]
                 else c("  (block is out of date; re-run --install)", AMBER)))
        print("line        " + state["line"])
        # The guard the line runs FIRST. Without this row a bin/oe that lost its
        # execute bit (a `cp -r` that dropped modes, a restore from a zip) reads
        # as "installed yes / supervisor not running" with nothing to explain it,
        # because the line silently no-ops on every shell.
        print("binary      " + state["oe"]
              + ("" if state["oe_executable"]
                 else c("   NOT EXECUTABLE -- the line silently does nothing; "
                        "chmod +x it", RED)))
        print(f"escape      export {state['disable_env']}=1"
              + (c("   (set in this shell)", AMBER) if state["disabled_now"] else ""))
        print("supervisor  " + (c(f"running (pid {state['supervisor_pid']})", GREEN)
                                if state["supervisor_running"] else c("not running", DIM)))
        for backup in state["backups"]:
            print(c(f"backup      {backup}", DIM))
        return 0

    print(f"{result['action']}  {result['rc']}")
    if result.get("backup"):
        print(c(f"  backup    {result['backup']}", DIM))
    if result.get("changed"):
        print(c(f"  md5       {result['md5_before']} -> {result['md5_after']}", DIM))
        if result.get("syntax_checked"):
            print(c("  zsh -n    parsed clean before the file was replaced", DIM))
        print(c(f"  disable   export {autostart_mod.DISABLE_ENV}=1", DIM))
    return 0


# ---------------------------------------------------------------------------
# oe watch -- the live view
# ---------------------------------------------------------------------------

ALT_SCREEN_ON = "\x1b[?1049h"
ALT_SCREEN_OFF = "\x1b[?1049l"
CURSOR_HIDE = "\x1b[?25l"
CURSOR_SHOW = "\x1b[?25h"
HOME = "\x1b[H"
CLEAR_LINE = "\x1b[K"
CLEAR_BELOW = "\x1b[J"


def _model_split(row: Dict[str, Any]) -> Tuple[Optional[Dict[str, Any]], List[Dict[str, Any]]]:
    """(the model in use right now, the other models this session paid for).

    A session is not one bill. Its subagents can run a different model, a resumed
    run can switch, and fast mode is a different price tier for the same name --
    so "the API being used, with its cost" cannot be answered by the session
    total. The per-model split comes off the same incremental scan as the
    headline and is rescaled with it, so the rows always sum to the total shown
    above them.
    """
    entries = [dict(e) for e in (row.get("cost_by_model") or []) if isinstance(e, dict)]
    model = row.get("model")
    raw_speed = row.get("speed")
    # A MISSING speed is not the same claim as speed="standard". Treating the
    # two alike silently picks the standard row as "in use" on a session whose
    # newest request billed at the fast tier -- a 10x price difference, hidden.
    speed = raw_speed if isinstance(raw_speed, str) and raw_speed else None
    if not entries:
        return None, []

    def key_of(entry: Dict[str, Any]) -> Tuple[str, str]:
        return (str(entry.get("model") or ""), str(entry.get("speed") or "standard"))

    exact = ([e for e in entries if key_of(e) == (str(model or ""), speed)]
             if speed is not None else [])
    if exact:
        current = exact[0]
        folded = {key_of(current)}
    else:
        # The row knows the model but not which tier the newest request billed
        # at (an older cache entry, or a request still being written). Summing
        # the model's tiers is the honest answer -- picking one would invent a
        # number the transcript does not support.
        same = [e for e in entries if str(e.get("model") or "") == str(model or "")]
        if not same:
            return None, entries
        current = {
            "model": model,
            "speed": (speed or str(same[0].get("speed") or "standard")) if len(same) == 1 else "",
            "cost_usd": sum(float(e.get("cost_usd") or 0) for e in same),
            "calls": sum(int(e.get("calls") or 0) for e in same),
            "tokens": sum(int(e.get("tokens") or 0) for e in same),
        }
        folded = {key_of(e) for e in same}
    others = [e for e in entries if key_of(e) not in folded]
    others.sort(key=lambda e: -float(e.get("cost_usd") or 0))
    return current, others


def _model_flags(speed: Any, effort: Any) -> str:
    """The two per-request switches that change what a name costs or means."""
    parts: List[str] = []
    if isinstance(speed, str) and speed.lower() == "fast":
        parts.append("fast")
    if isinstance(effort, str) and effort:
        parts.append(effort)
    return " ".join(parts)


def _aggregate(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    """Header numbers, each carrying whether anything in it was only measured."""
    active = [r for r in rows if r.get("is_active")]
    today = ledger_mod._local_day(time.time())
    live_tokens = sum(int(r.get("total_tokens") or 0) for r in active)
    priced = [r for r in rows if r.get("cost_known", True)]
    all_time = sum(float(r.get("cost_usd") or 0) for r in priced)
    # An aggregate is only as billed as its worst contributor: one measured
    # session in the sum makes the sum a floor, and it has to say so.
    today_rows = [r for r in rows
                  if (r.get("cost_by_day") or {}).get(today) or r.get("local_day") == today]
    return {
        "live_tokens": live_tokens,
        "live_usd": ledger_mod.spend_in_flight(rows),
        "live_estimate": any(r.get("cost_is_estimate") for r in active),
        "today_usd": ledger_mod.spend_today(rows),
        "today_estimate": any(r.get("cost_is_estimate") for r in today_rows),
        "all_usd": all_time,
        "all_estimate": any(r.get("cost_is_estimate") for r in rows),
        # A sum over SOME rows must never be captioned with the count of ALL of
        # them. On a cold cache the scan defers the biggest sessions, so a header
        # that reads one account's all-time total against the full session count
        # states a number well below what the label claims -- the same
        # silent-omission shape as "$0.00 in flight", moved one line down.
        # `sessions` is what the number covers.
        "sessions": len(priced),
        "sessions_total": len(rows),
        "unpriced": len(rows) - len(priced),
        "open": len(active),
    }


_HELP_LINES = [
    "q / Ctrl-C   quit and restore the terminal",
    "r            refresh now, do not wait for the next tick",
    "o            open this session's report.html in the desktop browser",
    "d            rebuild and open the cross-session dashboard",
    "?            hide this help",
    "",
    "Numbers:",
    "  [billed]           Claude Code's own cost-state total. Exact.",
    "  [billed+measured]  billed for the checkpointed runs, ours for the rest.",
    "  ~ / [measured]     ours, computed from the transcript. A FLOOR: sidechain",
    "                     files never receive the final output-token count, so a",
    "                     subagent-heavy session reads 8-25% under the real bill.",
    "  [queued]           not costed on this pass; the next one picks it up.",
    "",
    "Zero config: nothing was added to settings.json. The optional in-window",
    "status line is the one thing that needs it -- see `oe install-statusline`.",
]


def _watch_frame(rows: List[Dict[str, Any]], width: int, height: int,
                 tick: int, interval: float, view: Optional[Dict[str, Any]] = None
                 ) -> List[str]:
    """Build the whole screen in memory. Never writes; the caller repaints."""
    view = view or {}
    now = datetime.now().strftime("%H:%M:%S")
    active = [r for r in rows if r.get("is_active")]
    idle = [r for r in rows if not r.get("is_active")]
    agg = _aggregate(rows)

    spinner = "⣷⣯⣟⡿⢿⣻⣽⣾"[tick % 8] if active else "·"
    lines: List[str] = []

    # --- header: tokens / dollars in flight, then today and all-time ---------
    title_bar = (c(" Overwatch Enforcer ", "48;5;25;38;5;231;1")
                 + c(f" {spinner} ", GREEN if active else GREY)
                 + c(f"{agg['open']} open", WHITE if active else DIM)
                 + c(f"  ·  {now}  ·  every {interval:g}s", DIM)
                 # An unlabelled filtered pane reads as the whole machine: every
                 # figure below is a sum over this subset only.
                 + (c(f"  ·  account: {view['account']}", AMBER)
                    if view.get("account") else ""))
    lines.append(title_bar + " " * max(0, width - _visible_len(title_bar)))
    lines.append(_fit_segments([
        c(f"  {humanize_tokens(agg['live_tokens'])} tokens", BOLD)
        + c(" / ", DIM)
        + c(money(agg["live_usd"], estimate=agg["live_estimate"]), GREEN if active else DIM)
        + c(" in flight", DIM),
        c(f"    {money(agg['today_usd'], estimate=agg['today_estimate'])}", WHITE)
        + c(" today", DIM),
        c(f"    {money(agg['all_usd'], estimate=agg['all_estimate'])}", WHITE)
        + c(" all-time", DIM)
        # Welded to the number, NOT a trailing segment: _fit_segments drops from
        # the end, so a caption kept separate is the first thing a narrow pane
        # throws away -- and the one moment it must not is a cold cache, when
        # the number it qualifies is the one that is short.
        + (c(f" ({agg['sessions']}/{agg['sessions_total']} priced)", AMBER)
           if agg["unpriced"] else ""),
        c("" if agg["unpriced"] else f" ({agg['sessions']} sessions)", GREY),
    ], width))
    lines.append("")

    bar_width = max(14, min(40, width - 46))

    if not active:
        lines.append("  " + c("no session is running right now", DIM))
        lines.append("  " + c("start Claude Code in any project and it appears here", DIM))
        lines.append("")

    for row in active:
        overlay = live_snapshot(row["session_id"])
        used = row.get("context_tokens")
        maximum = row.get("max_tokens") or 200000
        cost = row.get("cost_usd")
        calls = row.get("calls")
        tokens = row.get("total_tokens")
        if row.get("cost_pending") and overlay:
            # The scan did not verify this session this pass; a watcher snapshot
            # is then the better of two unverified numbers. Never otherwise: a
            # .live.json left by a dead process would overwrite a figure the
            # scan just measured from the bytes on disk.
            cost = _pick(overlay, "cost_usd_authoritative", "cost_usd", default=cost)
            calls = _pick(overlay, "calls", default=calls)
            tokens = _pick(overlay, "total_tokens", default=tokens)
            used = _pick(overlay, "used_tokens", "context_tokens", default=used)
            maximum = _pick(overlay, "max_tokens", default=maximum) or maximum
        try:
            pct = 100.0 * float(used or 0) / float(maximum or 1)
        except Exception:
            pct = 0.0
        estimate = bool(row.get("cost_is_estimate"))

        # line 1 -- who and where
        heading = clip(private(row.get("title")) or paths.project_display(row.get("project") or "")
                       or short_sid(row["session_id"]), max(20, width - 30))
        lines.append("  " + c("●", GREEN) + " " + c(heading, BOLD))
        lines.append("    " + c(short_sid(row["session_id"]), DIM)
                     + c(" · ", GREY)
                     + c(clip(paths.project_display(row.get("project") or ""), 44), BLUE)
                     + c(" · active ", GREY) + c(ago(row.get("mtime")), DIM))

        # line 2 -- THE metric: tokens over dollars
        money_text = money(cost, known=row.get("cost_known", True), estimate=estimate)
        lines.append("    " + c(humanize_tokens(tokens), CYAN + ";1")
                     + c(" tokens", DIM) + c("  /  ", GREY)
                     + c(money_text, AMBER if float(cost or 0) >= 25 else GREEN)
                     + c(f"   {_source_tag(row)}", GREY))

        # line 3 -- the model actually in use, and what that model has cost
        current, others = _model_split(row)
        flags = _model_flags(row.get("speed"), row.get("effort"))
        if current is not None:
            model_cost = money(current.get("cost_usd"), estimate=estimate)
            lines.append("    " + c(pricing.display_name(current.get("model")), MAGENTA + ";1")
                         + (c(f" {flags}", MAGENTA) if flags else "")
                         + c(" · ", GREY) + c(model_cost, WHITE)
                         + c(" · ", GREY) + c(f"{int(current.get('calls') or 0):,} calls", DIM))
        else:
            lines.append("    " + c(pricing.display_name(row.get("model")), MAGENTA + ";1")
                         + (c(f" {flags}", MAGENTA) if flags else "")
                         + c(f" · {int(calls or 0):,} calls", DIM))
        for other in others[:2]:
            lines.append("      " + c("+ " + pricing.display_name(other.get("model")), DIM)
                         + (c(f" {other.get('speed')}", DIM)
                            if str(other.get("speed") or "standard") != "standard" else "")
                         + c(" · ", GREY)
                         + c(money(other.get("cost_usd"), estimate=estimate), DIM)
                         + c(f" · {int(other.get('calls') or 0):,} calls", DIM))

        # line 4 -- context window
        lines.append("    " + bar(pct, bar_width)
                     + c(f" {pct:5.1f}%", pct_color(pct))
                     + c(f"  {humanize_tokens(used)}/{humanize_tokens(maximum)}", WHITE)
                     + c(" context", DIM))
        lines.append("")

    # --- help overlay replaces the history table, never the live block -------
    if view.get("help"):
        lines.append(rule(width - 2, "keys"))
        for text in _HELP_LINES:
            lines.append("  " + c(text, DIM) if text else "")
        return lines

    footer_height = 4
    remaining = height - len(lines) - footer_height
    if idle and remaining > 2:
        lines.append(rule(width - 2, "recent"))
        # 2 + sid 8 + 1 + name + 1 + bar 12 + pct 5 + money 12 + ago 10 = 51+name.
        # Below 62 columns that row cannot hold the meter AND the dollars, and
        # _fit clips from the RIGHT -- so keeping the bar is choosing the
        # decoration over the number the view exists for. Drop the meter instead;
        # the live session above still has a full-width one.
        show_bar = width >= 62
        name_width = max(12, width - 62) if show_bar else max(6, width - 34)
        for row in idle[: max(0, remaining - 1)]:
            pct = float(row.get("context_pct") or 0)
            meter = (" " + bar(pct, 10) + c(f"{pct:5.1f}%", pct_color(pct))
                     if show_bar else "")
            lines.append("  " + c(short_sid(row["session_id"]), DIM)
                         + " " + c(clip(private(row.get("title")) or paths.project_display(
                             row.get("project") or ""), name_width).ljust(name_width), WHITE)
                         + meter
                         + c(f" {row_money(row):>11}", DIM)
                         + c(f" {ago(row.get('mtime')):>9}", DIM))
    return lines


def _watch_footer(rows: List[Dict[str, Any]], width: int,
                  view: Dict[str, Any]) -> List[str]:
    """Pinned to the bottom: where the reports are, and what the keys do."""
    active = [r for r in rows if r.get("is_active")]
    root = paths.reports_root()
    if active:
        target = (root / "sessions" / paths.report_dir_name(str(active[0]["session_id"]))
              / "report.html")
    else:
        target = root / "index.html"
    note = view.get("message") or ""
    supervisor = view.get("supervisor") or {}
    if not note:
        note = ("writing reports continuously (pid %s)" % supervisor.get("pid")
                if supervisor.get("running") else
                "supervisor not running -- reports will not refresh")
    # The note rides the rule, not the key row. Appended to the keys it was the
    # first segment a narrow pane dropped -- and "supervisor not running" is the
    # one line in this footer a reader must not miss.
    warn = "not running" in note
    head = "── " + note + " "
    return [
        c(head, AMBER if warn else GREY) + c("─" * max(0, width - 2 - len(head)), GREY),
        "  " + c(clip_left(str(target), width - 4), DIM),
        _fit_segments([
            "  " + c("q", WHITE) + c(" quit  ", DIM) + c("r", WHITE) + c(" refresh", DIM),
            c("  o", WHITE) + c(" report", DIM),
            c("  d", WHITE) + c(" dashboard", DIM),
            c("  ?", WHITE) + c(" help", DIM),
        ], width),
    ]


def _fit(text: str, width: int) -> str:
    """Hard-clip one rendered line to `width` visible columns, ANSI codes intact.

    Every frame line goes through here. A builder that miscounts by three columns
    wraps the terminal, a wrapped line pushes the whole screen down one row on
    each redraw, and that reads as violent flicker rather than as a layout bug --
    so the guarantee is enforced at the paint, not trusted to each caller.
    """
    if width <= 0:
        return ""
    out: List[str] = []
    visible = 0
    # Index in `out` of the last VISIBLE character, which is not the same as the
    # last element: this UI colours every field, so the element after the final
    # character is very often an SGR reset. Overwriting out[-1] with the ellipsis
    # then replaced an escape rather than a character and emitted width+1
    # columns -- one column is all it takes to wrap the row and shift the whole
    # frame down by one on every redraw -- and at a narrow width most rows in
    # the table came out one column over, not just a few.
    last_visible = -1
    index = 0
    clipped = False
    while index < len(text):
        char = text[index]
        if char == "\x1b":
            end = text.find("m", index)
            if end == -1:
                break
            out.append(text[index:end + 1])
            index = end + 1
            continue
        if visible >= width:
            clipped = True
            break
        out.append(char)
        last_visible = len(out) - 1
        visible += 1
        index += 1
    if clipped:
        if last_visible >= 0:
            out[last_visible] = "…"
        # Reset unconditionally: the clip can land inside a coloured run, and a
        # leaked SGR would paint the rest of the row when CLEAR_LINE follows.
        out.append("\x1b[0m")
    return "".join(out)


def _fit_segments(segments: List[str], width: int) -> str:
    """Join as many trailing-optional segments as fit. Segments are dropped from
    the END, so the leading ones -- the numbers this view exists for -- survive a
    narrow pane instead of being the ones cut off."""
    kept: List[str] = []
    used = 0
    for segment in segments:
        length = _visible_len(segment)
        if kept and used + length > width:
            break
        kept.append(segment)
        used += length
    return "".join(kept)


def _visible_len(text: str) -> int:
    out, index = 0, 0
    while index < len(text):
        if text[index] == "\x1b":
            end = text.find("m", index)
            if end == -1:
                break
            index = end + 1
            continue
        out += 1
        index += 1
    return out


def _ensure_supervisor_for_watch(args) -> Dict[str, Any]:
    """Zero-config: make sure something is actually tailing the live sessions.

    Without the (optional) hooks nothing spawns a per-session watcher, so this
    view would only ever show what a previous run happened to leave behind.
    Starting the supervisor here is what makes `oe watch` self-sufficient: one
    command in a second pane, no settings.json, nothing to install.

    Detached by default, because the report is meant to keep being written after
    the pane is closed; --inline keeps it inside this process instead, and
    --no-supervisor leaves it alone (a read-only look at existing data).
    """
    mode = "none" if getattr(args, "no_supervisor", False) else (
        "thread" if getattr(args, "inline", False) else "detached")
    try:
        from oe import watcher as watcher_mod
        return watcher_mod.ensure_supervisor(mode=mode)
    except Exception as exc:  # a viewer must never die because of the daemon
        return {"running": False, "pid": 0, "started": False, "mode": mode,
                "error": repr(exc)}


class _Terminal:
    """Owns every terminal mutation `oe watch` makes, and undoes all of them.

    A hidden cursor or a stuck alternate screen outlives this process and breaks
    the user's shell, so restore() is idempotent and reachable from the normal
    exit, an exception, SIGTERM, SIGHUP and atexit alike.
    """

    def __init__(self, stream) -> None:
        self.stream = stream
        self.saved_mode = None
        self.wake_read = -1
        self.wake_write = -1
        self.entered = False
        self.restored = False

    def enter(self) -> None:
        import atexit
        try:
            import termios
            import tty
            fd = sys.stdin.fileno()
            if sys.stdin.isatty():
                self.saved_mode = termios.tcgetattr(fd)
                tty.setcbreak(fd)
        except Exception:
            self.saved_mode = None
        # A self-pipe, not a bare handler: select() restarts on EINTR (PEP 475),
        # so a SIGWINCH handler that only sets a flag would not be noticed until
        # the tick expired -- a resize would leave the frame wrong for seconds.
        try:
            self.wake_read, self.wake_write = os.pipe()
            os.set_blocking(self.wake_read, False)
            os.set_blocking(self.wake_write, False)
            import signal
            signal.set_wakeup_fd(self.wake_write)
            # set_wakeup_fd only fires for signals that have a PYTHON handler, so
            # SIGWINCH needs one even though the redraw is all the work it does.
            for name, handler in (("SIGWINCH", self._noop),
                                  ("SIGTERM", self._terminate),
                                  ("SIGHUP", self._terminate)):
                sig = getattr(signal, name, None)
                if sig is not None:
                    signal.signal(sig, handler)
        except Exception:
            pass
        self.stream.write(ALT_SCREEN_ON + CURSOR_HIDE)
        self.stream.flush()
        self.entered = True
        atexit.register(self.restore)

    @staticmethod
    def _noop(signum, frame) -> None:
        """SIGWINCH only has to wake the select; the redraw reads the new size."""

    @staticmethod
    def _terminate(signum, frame) -> None:
        # Raising is what gets `finally` to run: the default SIGTERM action kills
        # the process outright and leaves the terminal in raw mode.
        raise KeyboardInterrupt()

    def drain_wakeups(self) -> None:
        try:
            while os.read(self.wake_read, 4096):
                pass
        except Exception:
            pass

    def restore(self) -> None:
        if self.restored:
            return
        self.restored = True
        try:
            import signal
            signal.set_wakeup_fd(-1)
        except Exception:
            pass
        try:
            if self.saved_mode is not None:
                import termios
                termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, self.saved_mode)
        except Exception:
            pass
        if self.entered:
            try:
                self.stream.write(CURSOR_SHOW + ALT_SCREEN_OFF)
                self.stream.flush()
            except Exception:
                pass
        for fd in (self.wake_read, self.wake_write):
            try:
                if fd >= 0:
                    os.close(fd)
            except Exception:
                pass
        self.wake_read = self.wake_write = -1


def _read_key(interactive: bool) -> Optional[str]:
    """One keypress, escape sequences drained so an arrow key is not four keys."""
    if not interactive:
        return None
    try:
        key = sys.stdin.read(1)
    except Exception:
        return None
    if key == "\x1b":
        import select as _select
        while True:
            ready, _, _ = _select.select([sys.stdin], [], [], 0)
            if not ready:
                break
            try:
                sys.stdin.read(1)
            except Exception:
                break
        return None
    return key


def _open_externally(target: Path) -> str:
    """xdg-open, failing silently by design: this runs under WSL, over ssh and
    in bare ttys where there is no browser to open anything with."""
    import subprocess
    for opener in ("xdg-open", "wslview", "open"):
        if not shutil.which(opener):
            continue
        try:
            subprocess.Popen([opener, str(target)],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            return f"opened {target.name}"
        except Exception:
            continue
    return f"no opener found -- {target}"


def _watch_open_report(rows: List[Dict[str, Any]]) -> str:
    active = [r for r in rows if r.get("is_active")] or rows
    if not active:
        return "no session to open"
    row = active[0]
    target = (paths.reports_root() / "sessions"
              / paths.report_dir_name(str(row["session_id"])) / "report.html")
    if not target.exists():
        try:
            _write_report(Path(row["transcript_path"]))
        except Exception as exc:
            return f"report build failed: {type(exc).__name__}"
    if not target.exists():
        return "report not built yet"
    return _open_externally(target)


def _watch_open_dashboard() -> str:
    target = paths.reports_root() / "index.html"
    try:
        from oe import dashboard as dashboard_mod
        target = Path(dashboard_mod.write_dashboard(paths.reports_root()))
    except Exception:
        if not target.exists():
            return "dashboard unavailable"
    return _open_externally(target)


_SUPERVISOR_RECHECK_SECONDS = 15.0


def _watch_supervisor_check(args, view: Dict[str, Any]) -> None:
    """Keep the background writer alive for the whole life of the pane.

    ensure_supervisor() at startup alone is not enough. A supervisor that dies
    afterwards -- crashed, OOM-killed, stopped by another tool, or reaped with
    its session -- leaves this view redrawing happily for hours with "supervisor
    not running" in the footer and nothing writing report.html. Nothing else
    looks wrong, because the numbers on screen are computed by the VIEWER: the
    failure is silent for exactly as long as the pane is left open, which is the
    whole point of the pane.

    So re-probe on a timer -- supervisor_running() is a pidfile read and a
    non-blocking flock -- and restart when it is gone. The timer is what keeps a
    spawn that keeps failing from turning the redraw loop into a fork loop.
    """
    if getattr(args, "no_supervisor", False):
        return
    now = time.time()
    if now - float(view.get("supervisor_checked") or 0.0) < _SUPERVISOR_RECHECK_SECONDS:
        return
    view["supervisor_checked"] = now
    record = view.get("supervisor") or {}
    thread = record.get("thread")
    if thread is not None and thread.is_alive():
        return  # --inline: it lives in this process, and it is still running
    try:
        from oe import watcher as watcher_mod
        pid = watcher_mod.supervisor_running()
    except Exception:
        return  # a viewer must never die because of the daemon
    if pid:
        record["running"] = True
        if pid > 0:
            record["pid"] = pid
        view["supervisor"] = record
        return
    view["supervisor"] = _ensure_supervisor_for_watch(args)
    view["supervisor_restarts"] = int(view.get("supervisor_restarts") or 0) + 1


def cmd_watch(args) -> int:
    interval = float(args.interval or (paths.load_config().get("refresh_seconds") or 2))
    interval = max(0.5, interval)
    supervisor = _ensure_supervisor_for_watch(args)

    account = getattr(args, "account", None)
    if account and accounts_mod.normalise_label(account) is None:
        print(c(f"unknown account '{account}'; expected one of "
                + ", ".join(accounts_mod.LABELS), RED), file=sys.stderr)
        return 2

    if not sys.stdout.isatty():
        # Piped, redirected or captured: one plain frame, no escape sequences,
        # no alternate screen, no loop. `oe watch | cat` has to be readable.
        rows = apply_account_filter(_rows(), account) or []
        # COLUMNS wins when it is set, which is how a pipe gets a sane width in
        # a script; a real pipe with no COLUMNS falls back to 100x44.
        size = shutil.get_terminal_size((100, 44))
        width, height = max(40, size.columns), max(20, size.lines)
        view = {"supervisor": supervisor, "help": bool(getattr(args, "help_open", False)),
                "account": accounts_mod.normalise_label(account) if account else None}
        for line in _watch_frame(rows, width, height, 0, interval, view):
            print(_strip_ansi(_fit(line, width)).rstrip())
        for line in _watch_footer(rows, width, view):
            print(_strip_ansi(_fit(line, width)).rstrip())
        return 0

    interactive = sys.stdin.isatty()
    terminal = _Terminal(sys.stdout)
    terminal.enter()
    view: Dict[str, Any] = {"help": bool(getattr(args, "help_open", False)),
                            "message": "", "supervisor": supervisor,
                            "account": accounts_mod.normalise_label(account) if account else None,
                            "supervisor_checked": time.time()}
    tick = 0
    try:
        while True:
            width, height = term_size()
            _watch_supervisor_check(args, view)
            # Filter every tick, not once: a session that starts under the other
            # account mid-view must not silently join the pane's totals.
            rows = apply_account_filter(_rows(), account) or []
            footer = _watch_footer(rows, width, view)
            body = _watch_frame(rows, width, height, tick, interval, view)
            body = body[: max(0, height - 1 - len(footer))]
            pad = max(0, height - 1 - len(footer) - len(body))
            frame = body + [""] * pad + footer
            # One write of the whole screen, painted over the old one from HOME:
            # clearing first is what makes a redraw flicker.
            out = [HOME]
            for line in frame[: height - 1]:
                out.append(_fit(line, width) + CLEAR_LINE + "\r\n")
            out.append(CLEAR_BELOW)
            sys.stdout.write("".join(out))
            sys.stdout.flush()
            tick += 1
            if getattr(args, "once", False):
                break

            action = _watch_wait(terminal, interval, interactive)
            if action == "quit":
                break
            if action == "help":
                view["help"] = not view["help"]
                view["message"] = ""
            elif action == "report":
                view["message"] = _watch_open_report(rows)
            elif action == "dashboard":
                view["message"] = _watch_open_dashboard()
            elif action == "refresh":
                view["message"] = ""
    except KeyboardInterrupt:
        pass
    finally:
        terminal.restore()
    return 0


def _watch_wait(terminal: "_Terminal", interval: float, interactive: bool) -> str:
    """Sleep until the next tick, a keypress, or a resize. Returns the action."""
    import select
    deadline = time.time() + interval
    watch_fds = []
    if interactive:
        watch_fds.append(sys.stdin)
    if terminal.wake_read >= 0:
        watch_fds.append(terminal.wake_read)
    if not watch_fds:
        time.sleep(interval)
        return "tick"
    while True:
        remaining = deadline - time.time()
        if remaining <= 0:
            return "tick"
        try:
            ready, _, _ = select.select(watch_fds, [], [], remaining)
        except (InterruptedError, OSError):
            return "tick"
        if not ready:
            return "tick"
        if terminal.wake_read in ready:
            # A signal arrived (SIGWINCH, most likely). Repaint at the new size.
            terminal.drain_wakeups()
            return "resize"
        key = _read_key(interactive)
        if key is None:
            continue
        if key in ("q", "Q", "\x03", "\x04"):
            return "quit"
        if key in ("r", "R"):
            return "refresh"
        if key in ("o", "O"):
            return "report"
        if key in ("d", "D"):
            return "dashboard"
        if key in ("?", "h", "H"):
            return "help"


def _strip_ansi(text: str) -> str:
    out, index = [], 0
    while index < len(text):
        if text[index] == "\x1b":
            end = text.find("m", index)
            if end == -1:
                break
            index = end + 1
            continue
        out.append(text[index])
        index += 1
    return "".join(out)


# ---------------------------------------------------------------------------
# oe dashboard / sessions / backfill
# ---------------------------------------------------------------------------


def cmd_dashboard(args) -> int:
    try:
        from oe import dashboard as dashboard_mod
    except Exception as exc:
        print(c(f"oe.dashboard unavailable: {exc}", RED), file=sys.stderr)
        return 2
    try:
        path = dashboard_mod.write_dashboard(paths.reports_root())
    except redact_mod.RedactionError as exc:
        print(c(str(exc), RED), file=sys.stderr)
        return 1
    print(path)
    return 0


def cmd_sessions(args) -> int:
    rows = _rows()
    scanned = len(rows)
    rows = apply_account_filter(rows, getattr(args, "account", None))
    if rows is None:
        return 2
    if args.active:
        rows = [r for r in rows if r.get("is_active")]
    if args.days:
        cutoff = time.time() - args.days * 86400
        rows = [r for r in rows if (r.get("mtime") or 0) >= cutoff]
    if args.limit:
        rows = rows[: args.limit]
    if args.json:
        # Same rule as `oe status --json`: a scan row carries `title` (Claude
        # Code's own summary of the session, e.g. 'webapp-v2-api-routing' --
        # which names the repo, which names the employer), `transcript_path`,
        # `slug` and the raw project slug. sessions.json on disk is built from
        # redact_scan_rows(); the piped form now is too.
        json.dump(_emit_json(rows, redact_mod.redact_scan_rows),
                  sys.stdout, indent=2, default=str)
        print()
        return 0
    if not rows:
        print("no sessions")
        return 0

    width, _ = term_size()
    # ACCOUNT is 10 columns wide, so the title gives up 10 -- the table already
    # sizes itself off the terminal and must not start wrapping because of it.
    # Ten, not nine: the widest cell this column can hold is 'personal?', the
    # guess mark included, and at nine that would touch the MODEL column.
    title_width = max(16, min(40, width - 86))
    # A pseudonym ('session_01') is two columns wider than an id prefix
    # ('718293a4'), and it is the pseudonym that joins this row to its report
    # directory, so the column gives way rather than the name being clipped.
    sid_width = 11 if _redacting() else 9
    header = (f"  {'SESSION':<{sid_width}}{'PROJECT':<20}{'ACCOUNT':<10}{'MODEL':<11}"
              f"{'TITLE':<{title_width}}"
              f"{'CALLS':>6}{'COST':>11}  {'CONTEXT':<20}{'LAST':>10}")
    print(c(header, DIM))
    total = 0.0
    unknown = 0
    estimated = 0
    queued = 0
    for row in rows:
        pct = float(row.get("context_pct") or 0)
        known = row.get("cost_known", True)
        if known:
            total += float(row.get("cost_usd") or 0)
        else:
            unknown += 1
        if row.get("cost_is_estimate"):
            estimated += 1
        if row.get("cost_pending"):
            queued += 1
        marker = c("●", GREEN) if row.get("is_active") else " "
        print(f"{marker} {short_sid(row['session_id']):<{sid_width}}"
              # clip_left, not clip: every project shares a "/home/<user>/…" prefix,
              # so trimming the tail rendered a session in .../repo/frontend
              # identically to one in .../repo. The tail is the discriminator.
              f"{clip_left(paths.project_display(row.get('project') or ''), 19):<20}"
              + account_cell(row)
              + f"{clip(pricing.display_name(row.get('model')), 10):<11}"
              f"{clip(private(row.get('title')), title_width - 1):<{title_width}}"
              f"{_calls_text(row):>6}{row_money(row):>11}  "
              + bar(pct, 10) + c(f"{pct:5.1f}%", pct_color(pct))
              + f"{ago(row.get('mtime')):>11}")
    # Both figures are computed over the rows actually PRINTED, so a --limit /
    # --days / --active filter must say so rather than let "$N today" read
    # as the whole day.
    scope = "" if len(rows) == scanned else " (listed rows only)"
    if getattr(args, "account", None):
        scope += f" [account: {accounts_mod.normalise_label(args.account)}]"
    # "N sessions, $X total" reads as a total over ALL N when some of them
    # were not priced this pass; name what the sum actually covers.
    covers = "" if not unknown else f" across {len(rows) - unknown} of them"
    footer = (f"\n  {len(rows)} sessions, {money(total)} total{covers}, "
              f"{money(ledger_mod.spend_today(rows), estimate=True)} today{scope}")
    if unknown:
        # NOT "no cost-state on disk" -- that is a false diagnosis. A session
        # with cost-state lines still lands here, because the reason is always
        # the same one: this pass deferred the session and the cache had
        # no earlier figure to fall back on. The cure is another cheap pass, not
        # `oe backfill --all --force`, which re-parses every byte on disk.
        footer += (f" -- {unknown} not priced on this pass "
                   f"(the cost cache is still priming); run `oe sessions` again")
    if estimated:
        # Not a footnote: without this line a reader cannot tell a billed figure
        # from a measured floor, and the two differ by 8-25% on any session that
        # leaned on subagents.
        footer += (f"\n  ~ = measured from the transcript, not billed by Claude Code "
                   f"({estimated} of {len(rows)}). Sidechain transcripts never write back "
                   "their final output tokens, so those are floors.")
    if queued:
        footer += (f"\n  {queued} session(s) still queued for costing; run again to finish "
                   "priming the cache.")
    print(c(footer, DIM))
    return 0


def _account_selected(args, rows: List[Dict[str, Any]]) -> Optional[List[Dict[str, Any]]]:
    """Rows named by an `oe account assign` selector, or None when it names none.

    Exactly one of the four selectors applies, and a selector that matches
    nothing is an error rather than a silent no-op -- a `--before` typo that
    quietly assigned zero sessions would look identical to success.
    """
    picked: List[Dict[str, Any]] = []
    what = ""
    if args.session:
        what = f"session '{args.session}'"
        picked = [r for r in rows if str(r.get("session_id", "")).startswith(args.session)]
    elif args.before or args.after:
        bounds = []
        cutoff_before = _day_epoch(args.before) if args.before else None
        cutoff_after = _day_epoch(args.after) if args.after else None
        if args.before and cutoff_before is None:
            print(c(f"--before: '{args.before}' is not YYYY-MM-DD", RED), file=sys.stderr)
            return None
        if args.after and cutoff_after is None:
            print(c(f"--after: '{args.after}' is not YYYY-MM-DD", RED), file=sys.stderr)
            return None
        for row in rows:
            # The session's own start, not its last write: "before <date>"
            # is a statement about when the work began.
            when = accounts_mod._epoch(row.get("started_at")) or float(row.get("mtime") or 0.0)
            if cutoff_before is not None and when >= cutoff_before:
                continue
            if cutoff_after is not None and when < cutoff_after:
                continue
            picked.append(row)
        if args.before:
            bounds.append(f"before {args.before}")
        if args.after:
            bounds.append(f"on/after {args.after}")
        what = " and ".join(bounds)
    elif args.project:
        want = str(args.project).rstrip("/")
        what = f"project '{want}'"
        picked = [r for r in rows
                  if (paths.project_display(r.get("project") or "") or "").rstrip("/") == want
                  or str(r.get("project") or "") == want]
    else:
        print(c("give a session id/prefix, or --before / --after / --project", RED),
              file=sys.stderr)
        return None
    if not picked:
        print(c(f"no sessions match {what}", AMBER), file=sys.stderr)
        return None
    if args.session and len(picked) > 1:
        # A bare id reads as ONE session. A prefix that matches several is
        # legal, but it has to say so before it rewrites the attribution of
        # sessions the user was not thinking about.
        print(c(f"note: the prefix '{args.session}' matches {len(picked)} sessions, "
                "not one; all of them are listed below.", AMBER), file=sys.stderr)
    return picked


def _split_target(target: Optional[List[str]]) -> Tuple[Optional[str], List[str]]:
    """Pull the label out of free-order positionals; everything else is the selector."""
    label: Optional[str] = None
    rest: List[str] = []
    for token in list(target or []):
        found = accounts_mod.normalise_label(token)
        if found in (accounts_mod.LABEL_PERSONAL, accounts_mod.LABEL_WORK) and label is None:
            label = found
            continue
        rest.append(token)
    return label, rest


def _day_epoch(text: str) -> Optional[float]:
    """Local midnight of a YYYY-MM-DD day, or None. Local, because the user
    typing a date means their day, not UTC's."""
    try:
        parsed = datetime.strptime(str(text).strip(), "%Y-%m-%d")
        return parsed.timestamp()
    except Exception:
        return None


def cmd_account(args) -> int:
    action = getattr(args, "account_command", None) or "list"
    if action == "rename":
        # Labels are allocated, not decreed ("primary", "secondary"), so the
        # first thing anyone will want is to call them what they actually are.
        old_label, new_label = args.old, args.new
        result = accounts_mod.rename_label(old_label, new_label)
        if result.get("error"):
            print("  " + result["error"], file=sys.stderr)
            return 2
        if not result["ok"]:
            print(f"  nothing is labelled {old_label!r}; known labels: "
                  + ", ".join(accounts_mod.known_labels()), file=sys.stderr)
            return 1
        print(f"  {old_label!r} -> {new_label!r}: "
              f"{result['addresses']} address(es), {result['sessions']} session(s), "
              f"{result['identities']} identity record(s)")
        print("  (state only -- no report is rewritten until the next rebuild)")
        return 0
    if action == "whoami":
        who = accounts_mod.whoami()
        # The LABEL, never the address: that is the whole point of this command.
        print(c(str(who["label"]), account_colour(who["label"]))
              + c(f"   source: {who['source']}", DIM))
        print(c(f"   {who.get('detail') or ''}", DIM))
        return 0

    if action == "list":
        # infer=True only here: the org-quota hint costs a full-file scan, and
        # this is the one command whose job is to explain the labels.
        rows = _rows()
        try:
            accounts_mod.annotate_rows(rows, infer=True, scan_bytes=None)
        except Exception as exc:
            print(c(f"account resolution failed: {exc}", RED), file=sys.stderr)
        rows = apply_account_filter(rows, getattr(args, "account", None))
        if rows is None:
            return 2
        if getattr(args, "json", False):
            json.dump({
                "accounts": accounts_mod.rollup(rows),
                "provenance": accounts_mod.provenance_counts(rows),
                "sessions": [{"session_id": r.get("session_id"),
                              "account_label": r.get("account_label"),
                              "account_source": r.get("account_source"),
                              "account_evidence": r.get("account_evidence"),
                              "cost_usd": r.get("cost_usd"),
                              "started_at": r.get("started_at")} for r in rows],
            }, sys.stdout, indent=2, default=str)
            print()
            return 0
        width, _ = term_size()
        width = min(width, 110)
        print()
        for line in _account_rollup_lines(rows, width):
            print(line)
        print()
        print(rule(width, "provenance"))
        counts = accounts_mod.provenance_counts(rows)
        total = sum(counts.values()) or 1
        # Iterate what provenance_counts returned, not SOURCE_ORDER: the dict is
        # already in precedence order and carries any unfamiliar source at the
        # end, so this histogram sums to the same 24 the rollup above does.
        for name, count in counts.items():
            if not count:
                continue
            print("  " + c(f"{name:<10}", WHITE)
                  + f"{count:>4} session(s)  " + bar(100.0 * count / total, 24, colour=False)
                  + c(f"  {_SOURCE_MEANING.get(name, '')}", DIM))
        evidence = [r for r in rows if r.get("account_evidence")]
        if evidence:
            print()
            print("  " + c("evidence for the low-confidence labels:", DIM))
            for row in evidence:
                print("  " + c(short_sid(row["session_id"]), WHITE)
                      + c(f"  {row.get('account_label')} via {row.get('account_source')}", DIM))
                for line in _wrap(str(row.get("account_evidence")), width - 8):
                    print("      " + c(line, DIM))
        who = accounts_mod.whoami()
        print()
        print("  " + c("logged in now: ", DIM)
              + c(str(who["label"]), account_colour(who["label"]))
              + c(f"  ({who['source']})", DIM))
        return 0

    if action == "assign":
        label, leftover = _split_target(getattr(args, "target", None))
        if label is None:
            print(c("assign needs a label: " + " / ".join(
                n for n in accounts_mod.known_labels() if n != "unknown"), RED),
                file=sys.stderr)
            return 2
        if len(leftover) > 1:
            print(c(f"one session selector at a time, got {leftover}", RED), file=sys.stderr)
            return 2
        args.session = leftover[0] if leftover else None
        rows = _rows()
        picked = _account_selected(args, rows)
        if picked is None:
            return 2
        by_id = {str(r.get("session_id")): r for r in picked}
        changes = accounts_mod.assign(by_id.keys(), label, dry_run=True)
        moving = [ch for ch in changes if ch["changed"]]
        verb = "would set" if args.dry_run else "setting"
        print(c(f"{verb} {len(moving)} of {len(changes)} session(s) to "
                f"'{label}':", BOLD))
        for change in changes:
            row = by_id.get(change["session_id"], {})
            mark = c("→", AMBER) if change["changed"] else c("=", GREY)
            print(f"  {mark} {short_sid(change['session_id'])}  "
                  + c(f"{change['before']} ({change['before_source']})", DIM)
                  + c(f"  ->  {label} (assigned)" if change["changed"] else "  already assigned",
                      WHITE if change["changed"] else GREY)
                  + c(f"   {clip(private(row.get('title')), 40)}", DIM))
        if args.dry_run:
            print(c("\n  --dry-run: nothing was written", AMBER))
            return 0
        if not moving:
            print(c("  nothing to change", DIM))
            return 0
        accounts_mod.assign(by_id.keys(), label, dry_run=False)
        print(c(f"  wrote {len(moving)} assignment(s) to {accounts_mod.state_path()}", DIM))
        return 0

    if action == "unassign":
        _, leftover = _split_target(getattr(args, "target", None))
        if len(leftover) > 1:
            print(c(f"one session selector at a time, got {leftover}", RED), file=sys.stderr)
            return 2
        args.session = leftover[0] if leftover else None
        rows = _rows()
        picked = _account_selected(args, rows)
        if picked is None:
            return 2
        ids = [str(r.get("session_id")) for r in picked]
        changes = accounts_mod.unassign(ids, dry_run=True)
        moving = [ch for ch in changes if ch["changed"]]
        print(c(f"{'would clear' if args.dry_run else 'clearing'} "
                f"{len(moving)} of {len(changes)} assignment(s):", BOLD))
        for change in changes:
            mark = c("→", AMBER) if change["changed"] else c("=", GREY)
            print(f"  {mark} {short_sid(change['session_id'])}  "
                  + c(f"{change['before'] or '-'} ({change['before_source']})", DIM))
        if args.dry_run:
            print(c("\n  --dry-run: nothing was written", AMBER))
            return 0
        if moving:
            accounts_mod.unassign(ids, dry_run=False)
        return 0

    print(c(f"unknown account action '{action}'", RED), file=sys.stderr)
    return 2


_SOURCE_MEANING = {
    "assigned": "you said so (`oe account assign`)",
    "recorded": "the transcript's own bridge-session ownerAccountUuid",
    "stamped": "captured live from the logged-in account while it ran",
    "backup": "a ~/.claude/backups snapshot window brackets its start",
    "inferred": "a low-confidence hint; see the evidence below",
    "unknown": "nothing on disk names an account for it",
}


def cmd_backfill(args) -> int:
    transcripts = list(paths.iter_transcripts())
    if args.days and not args.all:
        cutoff = time.time() - args.days * 86400
        transcripts = [t for t in transcripts if t.stat().st_mtime >= cutoff]
    elif not args.all and not args.days:
        cutoff = time.time() - 7 * 86400
        transcripts = [t for t in transcripts if t.stat().st_mtime >= cutoff]

    built = skipped = failed = 0
    started = time.perf_counter()
    for index, transcript in enumerate(sorted(transcripts, key=lambda p: -p.stat().st_mtime), 1):
        session_id = transcript.stem
        out_dir = paths.reports_root() / "sessions" / paths.report_dir_name(session_id)
        existing = out_dir / "report.html"
        if not args.force and existing.exists():
            try:
                if existing.stat().st_mtime >= transcript.stat().st_mtime:
                    skipped += 1
                    continue
            except OSError:
                pass
        label = f"[{index}/{len(transcripts)}] {short_sid(session_id)} " \
                f"{transcript.stat().st_size / 1e6:5.1f}MB"
        try:
            written = _write_report(transcript)
            ledger = written.get("ledger")
            cost = ledger.totals["cost_usd_authoritative"] if ledger else 0
            print(f"{label}  {money(cost):>10}")
            built += 1
        except Exception as exc:
            print(c(f"{label}  failed: {exc}", RED), file=sys.stderr)
            failed += 1
    print(c(f"\n  built {built}, skipped {skipped}, failed {failed} "
            f"in {time.perf_counter() - started:.1f}s", DIM))
    try:
        from oe import dashboard as dashboard_mod
        print("  " + str(dashboard_mod.write_dashboard(paths.reports_root())))
    except Exception as exc:
        print(c(f"  dashboard skipped: {exc}", AMBER))
    return 1 if failed else 0


# ---------------------------------------------------------------------------
# oe doctor / reprice
# ---------------------------------------------------------------------------

def _hook_events() -> Dict[str, str]:
    """event -> script, taken FROM THE INSTALLER's plan.

    A second copy of the list here would drift. The installer decides which
    events are registered, and a checker carrying its own list reports a clean
    bill of health on a machine that is missing a hook the installer would have
    written. One list, imported, is the only arrangement in which that cannot
    happen.
    """
    try:
        import install as installer
        return {event: script for event, script, _timeout in installer.HOOK_PLAN}
    except Exception:
        return {
            "SessionStart": "session_start.py",
            "UserPromptSubmit": "user_prompt_submit.py",
            "PreToolUse": "pre_tool_use.py",
            "PostToolUse": "post_tool_use.py",
            "PostToolUseFailure": "post_tool_use.py",
            "Stop": "stop.py",
            "PreCompact": "pre_compact.py",
            "PostCompact": "post_compact.py",
            "SessionEnd": "session_end.py",
        }


HOOK_EVENTS = _hook_events()


# Printed absolute on purpose: doctor runs from any cwd, and a relative
# "python3 install.py --yes" is wrong from all but one directory -- which is
# exactly the moment the user needs it to work.
OE = f"{INSTALL_ROOT}/bin/oe"
INSTALL_COMMAND = f"python3 {INSTALL_ROOT}/install.py --yes"
INSTALL_STATUSLINE_COMMAND = f"{OE} install-statusline"
UNINSTALL_STATUSLINE_COMMAND = f"{OE} uninstall-statusline --yes"


class _Doctor:
    def __init__(self) -> None:
        self.failures = 0
        self.warnings = 0
        self.optional = 0

    def opt(self, label: str, detail: str = "") -> None:
        """An opt-in extra that is not installed. Counted separately from a
        warning, because choosing not to install something is not a defect and
        must not colour the verdict."""
        self.optional += 1
        print("  " + c("○", BLUE) + f" {label}" + (c(f"  {detail}", DIM) if detail else ""))

    def info(self, label: str, detail: str = "") -> None:
        """Context, not a check -- it must not move the pass/fail counts."""
        print("  " + c("·", DIM) + f" {label}" + (c(f"  {detail}", DIM) if detail else ""))

    def ok(self, label: str, detail: str = "") -> None:
        print("  " + c("✓", GREEN) + f" {label}" + (c(f"  {detail}", DIM) if detail else ""))

    def warn(self, label: str, detail: str = "") -> None:
        self.warnings += 1
        print("  " + c("!", AMBER) + f" {label}" + (c(f"  {detail}", DIM) if detail else ""))

    def fail(self, label: str, detail: str = "") -> None:
        self.failures += 1
        print("  " + c("✗", RED) + f" {label}" + (c(f"  {detail}", DIM) if detail else ""))


def _project_dir() -> Optional[Path]:
    """The directory Claude Code would treat as this session's project root.

    Hooks get CLAUDE_PROJECT_DIR in the environment; from a bare shell we fall
    back to the nearest ancestor of the cwd carrying a .claude/ directory, which
    is where a project-scoped settings file would live.
    """
    env = os.environ.get("CLAUDE_PROJECT_DIR")
    if env and os.path.isdir(env):
        return Path(env)
    try:
        here = Path(os.getcwd()).resolve()
    except Exception:
        return None
    home = paths.CLAUDE_HOME.resolve()
    for candidate in (here, *here.parents):
        marker = candidate / ".claude"
        if not marker.is_dir():
            continue
        # ~/.claude is the install/config home, not a project: treating $HOME as a
        # project would re-read the user settings file under a "project" label and
        # report it twice.
        if marker.resolve() == home:
            continue
        return candidate
    return None


def _settings_scopes(explicit: Optional[str]) -> List[Tuple[str, Path, bool]]:
    """(label, path, reaches_every_session) for the settings files CC merges.

    Read out of the 2.1.265 binary, which labels exactly these three file scopes:
    "User settings (~/.claude/settings.json)", "Project settings
    (.claude/settings.json)" and "Local settings (.claude/settings.local.json)".
    Only the user scope reaches sessions in every project, so an install found
    only in a project/local file is reported as partial rather than a clean pass:
    it is genuinely live, but it stops at that checkout's boundary.
    """
    if explicit:
        return [("--settings", Path(explicit).expanduser(), True)]
    scopes = [("user", paths.CLAUDE_HOME / "settings.json", True)]
    project = _project_dir()
    if project is not None:
        scopes.append(("project", project / ".claude" / "settings.json", False))
        scopes.append(("local", project / ".claude" / "settings.local.json", False))
    return scopes


def _load_scopes(doc: "_Doctor", explicit: Optional[str], *, required: bool = True
                 ) -> List[Tuple[str, Path, bool, Dict[str, Any]]]:
    """Read every settings file Claude Code merges. READ ONLY -- nothing here,
    and nothing doctor does, ever writes to one.

    `required=False` is the zero-config reading: a machine with no
    ~/.claude/settings.json is perfectly healthy, so its absence is information,
    not a failure.
    """
    loaded: List[Tuple[str, Path, bool, Dict[str, Any]]] = []
    seen: set = set()
    for label, path, is_global in _settings_scopes(explicit):
        try:
            key = path.resolve()
        except Exception:
            key = path
        if key in seen:
            continue
        seen.add(key)
        if not path.exists():
            # Only the user file (or one named explicitly) is expected to exist;
            # a project without .claude/settings.json is the normal case.
            if label in ("user", "--settings"):
                if required:
                    doc.fail(f"{label} settings", f"{path} does not exist")
                else:
                    doc.info(f"{label} settings", f"{path} does not exist")
            continue
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except Exception as exc:
            doc.fail(f"{label} settings", f"{path}: unreadable: {exc}")
            continue
        if not isinstance(data, dict):
            doc.fail(f"{label} settings", f"{path}: not a JSON object")
            continue
        doc.info(f"read {label} settings", f"{path}  (read only)")
        loaded.append((label, path, is_global, data))
    return loaded


def _find_hook(loaded: List[Tuple[str, Path, bool, Dict[str, Any]]], event: str,
               script: str) -> Tuple[Optional[Dict[str, Any]], Optional[str], bool]:
    """Locate our entry for `event` across every scope. Later scopes do not
    override earlier ones for hooks -- Claude Code runs the union -- so the first
    global-scope hit wins the label, and a project-only hit is reported as such."""
    hit: Tuple[Optional[Dict[str, Any]], Optional[str], bool] = (None, None, False)
    for label, _path, is_global, data in loaded:
        hooks = data.get("hooks")
        if not isinstance(hooks, dict):
            continue
        groups = hooks.get(event)
        if not isinstance(groups, list):
            continue
        for group in groups:
            if not isinstance(group, dict):
                continue
            entries = group.get("hooks")
            if not isinstance(entries, list):
                continue
            for entry in entries:
                if not isinstance(entry, dict):
                    continue
                command = str(entry.get("command") or "")
                if script in command and INSTALL_ROOT in command:
                    if hit[0] is None or (is_global and not hit[2]):
                        hit = (entry, label, is_global)
    return hit


def _missing_half(command: str) -> Optional[str]:
    """Which half of a "<interpreter> <script>" hook command is not on disk.

    Deliberately conservative and deliberately tiny: anything with shell syntax
    in it, or a token this shell cannot expand, returns None rather than a
    guess. Doctor reports; bin/oe-repair is the thing that acts, and it does the
    same check in far more detail without importing anything from oe/.
    """
    # Imported here rather than at the top: the module import block above is
    # ordered around the redaction bootstrap, and this is the only caller.
    import shlex
    text = command.strip()
    if not text or any(ch in text for ch in "|&;<>`$"):
        return None
    try:
        parts = shlex.split(text)
    except ValueError:
        return None
    if not parts:
        return None
    interpreter, rest = (parts[0], parts[1:]) if len(parts) > 1 else (None, parts)
    if interpreter is not None:
        found = shutil.which(interpreter) if "/" not in interpreter else (
            interpreter if os.access(interpreter, os.X_OK) else None)
        if not found:
            return f"the interpreter {interpreter} is not there"
    for token in rest:
        if token.startswith("-"):
            continue
        if not os.path.exists(token):
            return f"the script {token} is not there"
        break
    return None


def cmd_install_check(args) -> int:
    """`oe doctor --install`: the installer's own checklist, standalone.

    Deliberately importable from a tree that is NOT installed, so a co-worker
    can clone, run this, and find out what is missing before anything touches a
    settings file. It writes nothing at all.
    """
    root = Path(getattr(args, "dir", None) or INSTALL_ROOT).expanduser().resolve()
    settings = getattr(args, "settings", None)
    settings_path = Path(settings).expanduser() if settings else \
        paths.CLAUDE_HOME / "settings.json"
    try:
        from oe import checklist as checklist_mod
    except Exception as exc:
        print(f"  cannot load the checklist: {exc}", file=sys.stderr)
        return 2
    interpreter = sys.executable or "python3"
    reports = None
    try:
        reports = paths.reports_root()
    except Exception:
        reports = None
    report = checklist_mod.build(
        root, settings_path, interpreter,
        probe_binary=not getattr(args, "no_binary_probe", False),
        allow_missing_claude=False, reports_root=reports)
    print(checklist_mod.render(report))
    if not report.ok:
        print(f"  {len(report.failures)} hard failure(s); this machine is not ready.",
              file=sys.stderr)
        return 1
    print("  Ready. Next: " + str(root / "install.py") + " --yes")
    return 0


def cmd_doctor(args) -> int:
    """Two verdicts, not one.

    The primary path is the whole product and takes zero configuration, so it is
    the only thing allowed to fail the run. The status line and the hooks are
    opt-in extras: a machine that has never installed them is CORRECT, and
    reporting that as six red crosses -- which is what one combined verdict
    would do -- trains the reader to ignore the one cross that would matter.
    """
    if getattr(args, "install", False):
        return cmd_install_check(args)

    doc = _Doctor()
    width, _ = term_size()
    width = min(width, 100)

    print()
    print(rule(width, "primary path -- works with no configuration"))

    # redact.py belongs on this list, not below it: every writer routes through
    # it, and a missing or broken redact.py is the one failure that turns a
    # shareable tree into a leaking one.
    for relative in ("oe/__init__.py", "oe/paths.py", "oe/pricing.py", "oe/ledger.py",
                     "oe/redact.py", "oe/report.py", "oe/watcher.py", "oe/dashboard.py",
                     "oe/accounts.py", "bin/oe"):
        path = Path(INSTALL_ROOT) / relative
        if path.exists():
            doc.ok(relative, f"{path.stat().st_size:,} B")
        else:
            doc.fail(relative, "missing")

    # config.json is the one row on this list that is allowed to be ABSENT.
    #
    # The repo tracks config.example.json and nothing else, so `git clone`
    # leaves you here, and load_config() deep-merges DEFAULT_CONFIG, so here is
    # a fully working install. Reporting it as a failure ended a stranger's
    # first command on "PRIMARY PATH BROKEN: 1 failing" and exit 1, which is
    # the opposite of what the install and configuration docs promise -- and it
    # is the report the README asks people to attach to bug reports.
    #
    # A config.json that EXISTS and cannot be read is a different thing: the
    # user wrote settings this run is not honouring, and silence there would be
    # worse than the false alarm above.
    config_path = Path(INSTALL_ROOT) / "config.json"
    if not config_path.exists():
        doc.info("config.json",
                 "not present -- defaults are in force, which is the supported "
                 "zero-config state (copy config.example.json to change one)")
    else:
        try:
            with config_path.open(encoding="utf-8") as handle:
                loaded = json.load(handle)
            if not isinstance(loaded, dict):
                raise ValueError(f"top level is {type(loaded).__name__}, not an object")
            doc.ok("config.json", f"{config_path.stat().st_size:,} B, "
                                  f"{len(loaded)} top-level key(s)")
        except Exception as exc:
            doc.fail("config.json", f"present but unreadable: {type(exc).__name__}: {exc}")

    for name in ("redact", "report", "watcher", "dashboard"):
        try:
            __import__(f"oe.{name}")
            doc.ok(f"oe.{name}", "imports")
        except Exception as exc:
            doc.fail(f"oe.{name}", f"{type(exc).__name__}: {exc}")

    # The gate has to be shown WORKING, not just importable: a redact.py whose
    # patterns were edited into uselessness still imports fine.
    try:
        probe = "ran /home/x for ABC-1 as a@b.co on feature/x 11111111-2222-3333-4444-555555555555"
        kinds = {f.kind for f in redact_mod.blocking(redact_mod.audit(probe))}
        missing = {"home", "ticket", "email", "branch", "uuid"} - kinds
        if missing:
            doc.fail("redaction gate", f"does not block {', '.join(sorted(missing))}")
        else:
            doc.ok("redaction gate", "blocks email / path / uuid / ticket / branch")
    except Exception as exc:
        doc.fail("redaction gate", f"{type(exc).__name__}: {exc}")

    root = paths.PROJECTS_ROOT
    if not root.is_dir():
        # NOT a failure. Claude Code creates ~/.claude/projects when it writes
        # its first transcript, so on a machine that has installed this tool
        # before running a session the directory is simply not there yet --
        # exactly like "session reports: none yet" and "supervisor: not
        # running", both of which this same page prints as informational.
        #
        # A checker that cries wolf on a clean machine teaches people to ignore
        # it, which costs more than the check is worth: doc.fail() here would end
        # a correct fresh install on "PRIMARY PATH BROKEN: 1 failing" and exit 1,
        # as the first thing a new user sees after install.py says
        # "Then: oe doctor".
        doc.info("transcripts",
                 f"{root} does not exist yet -- Claude Code creates it on its "
                 f"first session")
        transcripts: List[Path] = []
    else:
        transcripts = list(paths.iter_transcripts())
        total_mb = sum(t.stat().st_size for t in transcripts if t.exists()) / 1e6
        doc.ok("transcripts readable", f"{len(transcripts)} files, {total_mb:,.0f} MB, "
                                       f"under {root}")

    rows: List[Dict[str, Any]] = []
    try:
        started = time.perf_counter()
        rows = ledger_mod.scan_sessions()
        elapsed = (time.perf_counter() - started) * 1000
        pending = sum(1 for r in rows if r.get("cost_pending"))
        detail = f"{len(rows)} sessions in {elapsed:.0f} ms"
        if pending:
            # Not a failure: a cold cache primes over a few passes and every
            # deferred session keeps the number it already had.
            doc.warn("scan_sessions", detail + f", {pending} still priming "
                                               "(run it again to finish)")
        else:
            doc.ok("scan_sessions", detail)
    except Exception as exc:
        doc.fail("scan_sessions", f"{type(exc).__name__}: {exc}")

    costed = [r for r in rows if r.get("cost_source")]
    if rows and not costed:
        doc.fail("cost attribution", "no session produced a cost source")
    elif costed:
        billed = sum(1 for r in costed if r.get("cost_source") == "reported")
        doc.ok("cost attribution", f"{billed} billed by Claude Code, "
                                   f"{len(costed) - billed} measured from the transcript")

    live = [r for r in rows if r.get("is_active")]
    if live:
        doc.ok("live session detected", f"{short_sid(live[0]['session_id'])} "
                                        f"{row_money(live[0])}, {ago(live[0].get('mtime'))}")
    else:
        doc.info("live session", "none running right now (not a fault)")

    # Is `oe` itself reachable by name? install.py --check reports this before an
    # install; nothing else reports it afterwards, so a PATH link removed later --
    # by an uninstall rehearsal, a dotfile sync, a cleanup script, a $HOME that
    # moved -- turns into "command not found" with no diagnosis anywhere. Never a
    # failure: running by full path is a legitimate way to use this tool.
    try:
        here = Path(INSTALL_ROOT).resolve()
        found = shutil.which("oe")
        if not found:
            doc.warn("oe on PATH",
                     f"`oe` is not on PATH -- run `python3 {here}/install.py --yes`, "
                     f"or link {here}/bin/oe into a directory on PATH")
        elif Path(found).resolve() == (here / "bin" / "oe").resolve():
            doc.ok("oe on PATH", found)
        else:
            doc.warn("oe on PATH",
                     f"`oe` resolves to {found}, which is NOT this install "
                     f"({here}) -- two copies are installed")
    except Exception as exc:
        doc.warn("oe on PATH", f"{type(exc).__name__}: {exc}")

    reports = paths.reports_root()
    try:
        paths.ensure_dir(reports)
        probe = reports / ".oe-doctor-probe"
        probe.write_text("ok", encoding="utf-8")
        probe.unlink()
        doc.ok("reports writable", str(reports))
    except Exception as exc:
        doc.fail("reports writable", f"{reports}: {exc}")

    # Where the reports ACTUALLY are, versus where this process thinks they go.
    #
    # Three ways they diverge, all of them silent today:
    #   * config.json's reports_root was edited or reset (an install rehearsal,
    #     a re-share of the tree, a hand edit);
    #   * paths.reports_root() fell back to the portable default because the
    #     configured root was briefly unwritable -- it returns the default and
    #     writes NOTHING, so config.json still names the old one;
    #   * the running supervisor was started against a different root and is
    #     still writing there.
    # In every case `reports writable` above is a cheerful green tick on an
    # empty directory while the real history sits somewhere else: the effective
    # root holds no sessions at all and every session folder is under the
    # configured one. A health check that cannot see that is not a health
    # check.
    try:
        configured = str((paths.load_config() or {}).get("reports_root") or "")
        expanded = Path(configured).expanduser() if configured else None
        if expanded and expanded.resolve() != reports.resolve():
            doc.warn("reports root",
                     f"config.json says {configured}, but this process resolves "
                     f"{reports} -- the configured root was not usable and the "
                     f"portable default was substituted")
        def _count(root: Optional[Path]) -> int:
            try:
                return len(list((root / "sessions").glob("*/report.html"))) if root else 0
            except Exception:
                return 0

        here = _count(reports)
        # Candidate roots this machine has actually used. The supervisor's own
        # state file is the useful one: it records the root it was started
        # against, so it still names the old tree after config.json has moved
        # on -- which is the only witness left when the edit was a plain,
        # writable, empty directory that looks exactly like a fresh install.
        elsewhere: List[Tuple[str, int]] = []
        seen_roots = {str(reports.resolve())}
        candidates = [(configured, expanded)]
        try:
            sup = json.loads((paths.state_dir() / "supervisor.json").read_text(
                encoding="utf-8"))
            if isinstance(sup, dict) and sup.get("reports_root"):
                candidates.append((str(sup["reports_root"]),
                                   Path(str(sup["reports_root"])).expanduser()))
        except Exception:
            pass
        for label, root in candidates:
            if not root:
                continue
            try:
                key = str(root.resolve())
            except Exception:
                continue
            if key in seen_roots:
                continue
            seen_roots.add(key)
            count = _count(root)
            if count:
                elsewhere.append((label, count))
        if here == 0 and elsewhere:
            where = "; ".join(f"{n} under {label}" for label, n in elsewhere)
            doc.warn("reports root",
                     f"0 reports under the effective root ({reports}), but {where} "
                     f"-- config.json's reports_root has moved away from the tree "
                     f"that holds your history")
        elif here == 0:
            doc.info("reports root", "no reports yet -- `oe report` writes the first")
        else:
            doc.ok("reports root", f"{here} report(s) under the effective root")
    except Exception as exc:
        doc.warn("reports root", f"{type(exc).__name__}: {exc}")

    # The reports root is the directory the user hands to somebody else, and
    # state_dir() holds the map that turns every `session_07` in it back into a
    # real session. Nesting the two is the whole leak, so assert the separation
    # here rather than trusting that nobody re-derived one from the other.
    try:
        state = paths.state_dir()
        legacy = reports / paths.LEGACY_STATE_DIRNAME
        if state.resolve().is_relative_to(reports.resolve()):
            doc.fail("state outside reports",
                     f"{state} sits INSIDE the shared tree -- a tar of {reports} "
                     f"would ship the pseudonym map")
        elif legacy.exists():
            doc.warn("state outside reports",
                     f"{state}, but a stale {legacy} is still there: restart the "
                     f"daemon (oe supervise --stop && oe supervise --ensure)")
        else:
            doc.ok("state outside reports", str(state))
    except Exception as exc:
        doc.warn("state outside reports", f"{type(exc).__name__}: {exc}")

    try:
        cache_dir = paths.state_dir() / "cost-cache"
        entries = list(cache_dir.glob("*.json")) if cache_dir.is_dir() else []
        size = sum(p.stat().st_size for p in entries)
        doc.ok("cost cache", f"{len(entries)} entries, {size / 1e6:.1f} MB, {cache_dir}")
    except Exception as exc:
        doc.warn("cost cache", f"{type(exc).__name__}: {exc}")

    built = list((reports / "sessions").glob("*/report.html")) if reports.is_dir() else []
    if built:
        newest = max(built, key=lambda p: p.stat().st_mtime)
        doc.ok("session reports", f"{len(built)} built, newest {ago(newest.stat().st_mtime)}")
    else:
        doc.info("session reports", "none yet -- `oe watch` or `oe report` writes them")

    try:
        from oe import watcher as watcher_mod
        state = watcher_mod.supervisor_status()
        if state.get("running"):
            doc.ok("supervisor", f"pid {state['pid']}, status "
                                 f"{state.get('status_age_seconds')}s old")
        else:
            doc.info("supervisor", "not running -- `oe watch` starts it")
    except Exception as exc:
        doc.warn("supervisor", f"{type(exc).__name__}: {exc}")

    if not args.no_pricing:
        try:
            sys.path.insert(0, INSTALL_ROOT)
            import extract_pricing
            binary = extract_pricing.newest_binary()
            if binary is None:
                doc.warn("pricing table", "no claude binary under "
                                          + str(extract_pricing.VERSIONS_DIR))
            else:
                started = time.perf_counter()
                catalog = extract_pricing.extract(binary)
                issues = extract_pricing.compare(catalog)
                elapsed = time.perf_counter() - started
                if issues:
                    # Wrong prices make every dollar on the screen wrong, so this
                    # one IS a primary-path failure.
                    doc.fail("pricing table", f"{len(issues)} differences vs {binary.name} "
                                              f"-- run: {INSTALL_ROOT}/bin/oe reprice")
                    for issue in issues[:8]:
                        print(c("      " + issue, DIM))
                else:
                    doc.ok("pricing table", f"matches {binary.name} "
                                            f"({len(catalog['models'])} models, {elapsed:.1f}s)")
        except Exception as exc:
            doc.warn("pricing table", f"check failed: {exc}")
    else:
        doc.info("pricing table", "skipped (--no-pricing)")

    primary_failures = doc.failures

    # ------------------------------------------------------------------ opt-in
    print()
    print(rule(width, "optional: in-window status line"))
    _compiles(doc, Path(INSTALL_ROOT) / "oe" / "statusline.py")
    loaded = _load_scopes(doc, getattr(args, "settings", None), required=False)
    status_line, status_scope, status_global = None, None, False
    for label, _path, is_global, data in loaded:
        candidate = data.get("statusLine")
        if isinstance(candidate, dict) and (status_line is None or (is_global and not status_global)):
            status_line, status_scope, status_global = candidate, label, is_global
    command = str((status_line or {}).get("command") or "")
    if "statusline.py" in command and INSTALL_ROOT in command:
        scope_note = "" if status_global else f"  [{status_scope} scope: this checkout only]"
        doc.ok("statusLine installed",
               f"refresh={(status_line or {}).get('refreshInterval')}s{scope_note}")
        _time_statusline(doc)
        print("      " + c(f"remove it with: {UNINSTALL_STATUSLINE_COMMAND}", DIM))
    elif command:
        doc.opt("statusLine", f"points at something else, left alone: {clip(command, 46)}")
    else:
        doc.opt("statusLine", "not installed (optional)")
        print("      " + c("adds a cost/context row inside the Claude Code window; it is the "
                           "one", DIM))
        print("      " + c("feature that cannot work without a settings.json key.", DIM))
        print("      " + c(f"preview the exact diff:  {INSTALL_STATUSLINE_COMMAND}", WHITE))
        print("      " + c(f"then apply it with:      {INSTALL_STATUSLINE_COMMAND} --yes", DIM))

    print()
    print(rule(width, "optional: hooks"))
    for name in sorted(set(HOOK_EVENTS.values())):
        _compiles(doc, Path(INSTALL_ROOT) / "hooks" / name)
    wired = 0
    broken_hooks = 0
    for event, script in HOOK_EVENTS.items():
        found, scope, is_global = _find_hook(loaded, event, script)
        if found is None:
            continue
        wired += 1
        detail = f"-> {script}  timeout={found.get('timeout')}s"
        gone = _missing_half(str(found.get("command") or ""))
        if gone:
            # The failure this whole rescue path exists for, seen from the
            # other side. A registered hook whose command names a file that is
            # not there breaks every tool call in every session -- including the
            # ones you would use to fix it -- so this is a failure, not a
            # warning, and the way out is a command that does not run inside
            # Claude Code.
            doc.fail(event, f"{detail}  -- {gone}")
            broken_hooks += 1
        elif is_global:
            doc.ok(event, detail)
        else:
            doc.warn(event, f"{detail}  [{scope} scope: this checkout only]")
    if broken_hooks:
        print("      " + c(f"repair it from a plain shell (Claude Code cannot fix "
                           f"this from inside):", AMBER))
        print("      " + c(f"python3 {INSTALL_ROOT}/bin/oe-repair", WHITE)
              + c("        (diagnoses; v1.0.0 never writes)", DIM))
    if wired:
        state = paths.state_dir()
        tool_files = list(state.glob("*.tools.ndjson"))
        if tool_files:
            newest = max(tool_files, key=lambda p: p.stat().st_mtime)
            doc.ok("PostToolUse firing", f"{len(tool_files)} files, newest "
                                         f"{ago(newest.stat().st_mtime)}")
        else:
            doc.warn("PostToolUse events", "no *.tools.ndjson yet")
        # A hook that hardcodes the state directory instead of importing paths
        # can drift -- and drifting back under the reports root is how the
        # pseudonym map would end up in a shared folder again. Only hooks that
        # actually ship are checked; naming a deleted one produces a warning
        # about a file nobody has, which is noise that trains you to ignore
        # warnings.
        for script in ("session_start.py", "user_prompt_submit.py", "session_end.py"):
            hot_state = _hook_constant(script, "STATE_DIR")
            label = f"{script[:-3]} STATE_DIR"
            if isinstance(hot_state, str) and hot_state and \
                    os.path.normpath(hot_state) == os.path.normpath(str(state)):
                doc.ok(label, hot_state)
            elif hot_state is None:
                # No STATE_DIR constant at all means the hook resolves the
                # directory through paths, which is the pattern this check
                # exists to encourage. Warning about it trains the reader to
                # ignore warnings, so say so and move on.
                doc.ok(label, "not hardcoded; resolved via paths")
            else:
                doc.fail(label, f"hook writes {hot_state}, "
                                f"paths.state_dir() is {state}")

    else:
        doc.opt("hooks", f"none of {len(HOOK_EVENTS)} wired (optional)")
        print("      " + c("what they add: a report directory and start/end metadata written "
                           "at the", DIM))
        print("      " + c("right moments, a watcher started without you asking, and the budget "
                           "line on", DIM))
        print("      " + c("screen. Every number comes from the transcripts either way.", DIM))
        print("      " + c(f"install: {INSTALL_COMMAND.replace(' --yes', '')}   "
                           "(add --yes to apply)", DIM))

    print()
    print("  " + c("settings.json is never written by any command except "
                   "install-statusline/uninstall-statusline,", DIM))
    print("  " + c("and only when you pass --yes.", DIM))

    print()
    if primary_failures:
        print(c(f"  PRIMARY PATH BROKEN: {primary_failures} failing, "
                f"{doc.warnings} warnings", RED))
    elif doc.warnings:
        print(c(f"  primary path healthy, {doc.warnings} warnings, "
                f"{doc.optional} optional extras not installed", AMBER))
    else:
        print(c(f"  primary path healthy"
                + (f", {doc.optional} optional extras not installed" if doc.optional else ""),
                GREEN))
    print()
    # Exit status describes the PRIMARY path only. An uninstalled extra is a
    # choice, and a choice must not make a health check fail.
    return 1 if primary_failures else 0


def _compiles(doc: "_Doctor", path: Path) -> bool:
    """Byte-compile an opt-in script without running it.

    Importing a hook would execute it, and a hook reads stdin. A broken opt-in
    file is a warning, never a primary-path failure: nothing on the zero-config
    path imports it.
    """
    relative = str(path).replace(INSTALL_ROOT + "/", "")
    if not path.exists():
        doc.warn(relative, "missing -- the opt-in cannot be installed")
        return False
    try:
        compile(path.read_text(encoding="utf-8"), str(path), "exec")
    except SyntaxError as exc:
        doc.warn(relative, f"syntax error line {exc.lineno}")
        return False
    doc.ok(relative, "compiles")
    return True


# The only node types a hot-path constant is allowed to be built from. Anything
# else and _hook_constant refuses to evaluate rather than guess.
_CONST_NODES = ("Expression", "BoolOp", "BinOp", "Call", "Attribute", "Name",
                "Constant", "Load", "Or", "And", "Add", "Tuple", "List",
                "keyword", "Starred")
# The only names it will resolve. `os` is the real module, the other two are
# supplied with the values the hook itself would compute.
_CONST_NAMES = ("os", "INSTALL_ROOT", "__file__")


def _hook_constant(script: str, name: str) -> Optional[Any]:
    """The VALUE a hook's module-level constant would take, without running it.

    Importing the hook is not an option -- it reads stdin and exits the process --
    and scraping string literals out of the assignment was worse than useless:
    both hot-path hooks BUILD their state directory
    (`os.environ.get(...) or os.path.join(os.path.dirname(...), "state")`), so a
    literal scan found no path at all and returned None. `oe doctor` then printed
    "hook writes None" forever, and the divergence check the comments in
    post_tool_use.py and pre_tool_use.py both point at ("`oe doctor` fails if the
    two ever diverge") never actually compared anything.

    So evaluate the assignment instead, in a namespace holding exactly what the
    hook would see -- os, its own __file__, and the INSTALL_ROOT it derives from
    it -- and only after the expression has been proved to consist of nothing but
    attribute access and calls over those three names. A hook constant that grows
    past that returns None and the caller warns, which is the same answer as
    before but for an honest reason.
    """
    path = Path(INSTALL_ROOT) / "hooks" / script
    try:
        import ast
        tree = ast.parse(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    for node in tree.body:
        if not isinstance(node, ast.Assign):
            continue
        if name not in [t.id for t in node.targets if isinstance(t, ast.Name)]:
            continue
        try:
            for sub in ast.walk(node.value):
                if type(sub).__name__ not in _CONST_NODES:
                    return None
                if isinstance(sub, ast.Name) and sub.id not in _CONST_NAMES:
                    return None
            hook_file = str(path)
            scope = {
                "os": os,
                "__file__": hook_file,
                # Both hooks derive it the same way; supplying it keeps this
                # working whether the constant references INSTALL_ROOT or
                # recomputes the dirname chain inline.
                "INSTALL_ROOT": os.environ.get("OE_INSTALL_ROOT") or os.path.dirname(
                    os.path.dirname(os.path.abspath(hook_file))),
            }
            return eval(compile(ast.Expression(node.value), "<hook>", "eval"),
                        {"__builtins__": {}}, scope)
        except Exception:
            return None
    return None


def _hook_tuple(script: str, name: str) -> Optional[tuple]:
    """A tuple/list constant from a hook, or None. Literals only, no evaluation."""
    path = Path(INSTALL_ROOT) / "hooks" / script
    try:
        import ast
        tree = ast.parse(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    for node in tree.body:
        if not isinstance(node, ast.Assign):
            continue
        if name not in [t.id for t in node.targets if isinstance(t, ast.Name)]:
            continue
        try:
            return tuple(ast.literal_eval(node.value))
        except Exception:
            return None
    return None


def _time_statusline(doc: "_Doctor") -> None:
    """Prove the statusline stays inside its latency budget, in-process."""
    try:
        import io
        import contextlib
        from oe import statusline
    except Exception:
        return
    payload = {
        "hook_event_name": "Status", "session_id": "doctor", "cwd": os.getcwd(),
        "model": {"id": "claude-opus-5[1m]", "display_name": "Opus 5"},
        "version": "2.1.263",
        "cost": {"total_cost_usd": 1.23, "total_duration_ms": 60000},
        "context_window": {"used_tokens": 123456, "max_tokens": 1000000},
    }
    buffer = io.StringIO()
    started = time.perf_counter()
    try:
        with contextlib.redirect_stdout(buffer):
            stdin = sys.stdin
            sys.stdin = io.StringIO(json.dumps(payload))
            try:
                statusline.main()
            except SystemExit:
                pass
            finally:
                sys.stdin = stdin
        elapsed = (time.perf_counter() - started) * 1000
    except Exception as exc:
        doc.warn("statusline render", f"{type(exc).__name__}: {exc}")
        return
    text = buffer.getvalue().strip()
    if not text:
        doc.warn("statusline render", "produced no output")
    elif elapsed > 80:
        doc.warn("statusline render", f"{elapsed:.0f}ms (budget 80ms)")
    else:
        doc.ok("statusline render", f"{elapsed:.0f}ms, {len(text.splitlines())} lines")


# ---------------------------------------------------------------------------
# oe install-statusline / oe uninstall-statusline -- the only opt-in
# ---------------------------------------------------------------------------


# True when the last _run_installer() call found nothing to change. The wrapper
# uses it to suppress the "re-run with --yes" nudge after a no-op run, which
# otherwise tells the user to apply a change that does not exist.
_INSTALLER_NOOP = False


def _run_installer(argv: List[str]) -> int:
    """Run install.py in-process so its diff, its refuse-to-clobber checks and
    its read-back verification are the same code path either way.

    install.py is the ONLY file in this tree that writes settings.json, and it
    writes nothing without --yes. Keeping one writer is the point: two would be
    two chances to get the merge wrong.
    """
    sys.path.insert(0, INSTALL_ROOT)
    global _INSTALLER_NOOP
    import install as installer
    code = installer.main(argv)
    _INSTALLER_NOOP = bool(getattr(installer, "LAST_RUN_NOOP", False))
    return code


def cmd_install_statusline(args) -> int:
    """Wire the in-window status line, and nothing else.

    The status line is the single feature that genuinely cannot work without a
    settings.json key -- `statusLine` is Claude Code's only extension point for
    that row. Everything else in Overwatch Enforcer reads transcripts that are already
    on disk, so this stays opt-in and stays scoped: --only statusline never
    touches `hooks`.
    """
    # --dir/--non-interactive: this command already knows where the package is
    # and which file it is writing, so the installer's directory and scope
    # prompts have nothing to ask. Without them, `oe install-statusline` would
    # stop and ask two questions it already has the answers to.
    argv = ["--only", "statusline", "--settings", args.settings,
            "--dir", INSTALL_ROOT, "--non-interactive"]
    if args.force:
        argv.append("--force-statusline")
    if args.no_backup:
        argv.append("--no-backup")
    if args.yes:
        argv.append("--yes")
    code = _run_installer(argv)
    if code == 0 and not args.yes and not _INSTALLER_NOOP:
        print(c(f"  Nothing was written. Apply it with:", AMBER))
        print("      " + c(f"{INSTALL_STATUSLINE_COMMAND} --yes", WHITE))
        print(c(f"  Undo at any time with: {UNINSTALL_STATUSLINE_COMMAND}", DIM))
    elif code == 0 and args.yes:
        print()
        print(c("  The status line loads on the next session start. "
                "Nothing else changed.", DIM))
        print(c(f"  Undo with: {UNINSTALL_STATUSLINE_COMMAND}", DIM))
    return code


def cmd_uninstall_statusline(args) -> int:
    """Remove exactly the statusLine entry we installed, restoring a displaced
    one if install.py stashed it. Leaves any hooks alone."""
    argv = ["--uninstall", "--only", "statusline", "--settings", args.settings,
            "--dir", INSTALL_ROOT, "--non-interactive"]
    if args.no_backup:
        argv.append("--no-backup")
    if args.yes:
        argv.append("--yes")
    code = _run_installer(argv)
    if code == 0 and not args.yes and not _INSTALLER_NOOP:
        print(c("  Nothing was written. Apply it with:", AMBER))
        print("      " + c(f"{UNINSTALL_STATUSLINE_COMMAND}", WHITE))
    return code


def cmd_reprice(args) -> int:
    sys.path.insert(0, INSTALL_ROOT)
    import extract_pricing
    argv = ["--write", "--quiet"] + (["--binary", args.binary] if args.binary else [])
    code = extract_pricing.main(argv)
    if code == 0:
        print(c("pricing table is current", GREEN))
    return code


# ---------------------------------------------------------------------------
# oe audit / oe whois / oe rebuild -- the PII surface
# ---------------------------------------------------------------------------


# Every file under the reports root is a shareable artifact. There is no longer
# a private corner to carve out: runtime state moved to paths.STATE_ROOT, beside
# the code, precisely so that "everything in this directory is shareable" is a
# property of the layout rather than a promise the scanner has to keep. The
# tuple stays because a stale daemon running pre-relocation code can still
# recreate `.state/` here -- when that happens _private_state_files() names the
# files and _stray_session_maps() turns the session map into a hard failure.
#
# README.md is deliberately NOT excluded. It is prose we wrote rather than
# generated output, but it sits in the shareable directory and is the file most
# likely to be handed to somebody else first -- and being hand-written is
# exactly what makes it the likeliest place for a real path or address to be
# pasted in. Auditing it costs nothing and makes "clean: N artifact(s)" a claim
# about every file in the tree instead of every file but one. Nothing deletes
# from this list: `oe rebuild --purge` removes sessions/* plus index.html and
# sessions.json by name (see _purge_artifacts), never by this predicate.
_NON_ARTIFACT_DIRS = (".state",)
_NON_ARTIFACT_FILES = ()


def _artifact_files(root: Path) -> List[Path]:
    """Every generated file the user could hand to somebody else."""
    found: List[Path] = []
    if not root.is_dir():
        return found
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        try:
            relative = path.relative_to(root)
        except ValueError:
            continue
        if relative.parts and relative.parts[0] in _NON_ARTIFACT_DIRS:
            continue
        if relative.name in _NON_ARTIFACT_FILES:
            continue
        found.append(path)
    return found


def _private_state_files(root: Path) -> List[Tuple[Path, int]]:
    """Leftover files under <reports_root>/.state that carry identifying data.

    State now lives at paths.STATE_ROOT, outside every reports tree, so this
    should find nothing. It stays as a tripwire: a daemon started before the
    relocation still holds the old path in memory and will recreate `.state/`
    here, and that directory is the de-pseudonymisation oracle for the reports
    next to it -- session-map.json pairs every pseudonym with a real session id,
    title and transcript path, accounts.json holds the account address, the cost
    cache holds titles and absolute paths. `tar -czf r.tgz .` ships all of it.

    Reported, never auto-deleted: whatever wrote these may still have them open.
    The remedy is to restart the daemon (`oe supervise --stop; oe supervise
    --ensure`), which migrates the directory on its first path lookup.
    """
    state = root / ".state"
    if not state.is_dir():
        return []
    out: List[Tuple[Path, int]] = []
    for path in sorted(state.rglob("*")):
        if not path.is_file():
            continue
        blocking = len([f for f in redact_mod.audit_file(path)
                        if f.severity == "block"])
        if path.name == "session-map.json" or blocking:
            out.append((path, blocking))
    return out


def _stray_session_maps(root: Path) -> List[Path]:
    """Copies of the local pseudonym map anywhere but its one sanctioned home.

    The map is the only file that pairs `session_07` with a real session id and
    title. One copy loose in the reports tree hands a reader the key to every
    pseudonym in it, so finding one is a hard failure, not a warning.
    """
    if not root.is_dir():
        return []
    sanctioned = redact_mod.map_path().resolve()
    out = []
    for path in sorted(root.rglob("session-map.json")):
        try:
            if path.resolve() != sanctioned:
                out.append(path)
        except OSError:
            out.append(path)
    return out


def cmd_audit(args) -> int:
    """Scan what is ALREADY on disk. Exits non-zero on any blocking finding."""
    root = paths.reports_root()
    whole_tree = not (getattr(args, "session", None) and not args.all)
    if not whole_tree:
        transcript = resolve_transcript(args.session)
        session_id = transcript.stem if transcript else str(args.session)
        targets = _artifact_files(root / "sessions" / paths.report_dir_name(session_id))
        scope = f"session {short_sid(session_id)}"
    else:
        targets = _artifact_files(root)
        scope = str(root)

    print(rule(term_size()[0], "audit"))
    print(c(f"  scanning {len(targets)} artifact(s) under {scope}", DIM))

    blocking_total = review_total = 0
    clean = 0
    for path in targets:
        findings = redact_mod.audit_file(path)
        bad = [f for f in findings if f.severity == "block"]
        review = [f for f in findings if f.severity == "review"]
        blocking_total += len(bad)
        review_total += len(review)
        if not bad:
            clean += 1
            if args.verbose and review:
                print("  " + c("·", DIM) + f" {path.relative_to(root)}"
                      + c(f"  {len(review)} to review", DIM))
            continue
        print("  " + c("x", RED) + f" {path.relative_to(root)}"
              + c(f"  {len(bad)} finding(s)", RED))
        for finding in bad[: args.limit]:
            print(c(f"      {finding.kind:<9} byte {finding.offset:>9}  "
                    f"{finding.sample[:70]!r}", DIM))
        if len(bad) > args.limit:
            print(c(f"      ... {len(bad) - args.limit} more", DIM))

    strays = _stray_session_maps(root)
    for path in strays:
        blocking_total += 1
        print("  " + c("x", RED) + f" {path}  "
              + c("session map inside the reports tree", RED))

    if review_total and not args.verbose:
        print(c(f"  {review_total} ticket-shaped hit(s) classified as false positives "
                f"(model ids, CSS tokens, charset). Re-run with -v to list them.", DIM))
    if blocking_total:
        print(c(f"  FAIL: {blocking_total} finding(s) across "
                f"{len(targets) - clean} file(s)", RED))
        return 1
    # Resolving state_dir() first is what migrates a pre-relocation `.state/` out
    # of this tree, so anything _private_state_files() still finds afterwards is
    # genuinely stuck -- a live daemon holding the old path in memory -- rather
    # than a directory nobody has moved yet.
    state = paths.state_dir() if whole_tree else None
    # ...but say so. Migrating is a WRITE to the tree the caller asked us to
    # judge, and reporting "shareable" without mentioning that a session map was
    # just relocated out of it describes a tree that did not exist when the
    # command was typed. The privacy doc promises audit fails on a map found in
    # a reports tree; finding one and quietly moving it has to count as finding
    # one, or the promise is true only of the tree audit itself created.
    migrated = paths.legacy_state_report() if whole_tree else []
    if migrated:
        print(c(f"  MOVED -- {len(migrated)} file(s) were in a legacy .state/ inside "
                f"this tree and have been relocated to {state}:", AMBER))
        for row in migrated[: args.limit]:
            print(c(f"      {row.get('name')}  ({row.get('fate')})", DIM))
        if len(migrated) > args.limit:
            print(c(f"      ... {len(migrated) - args.limit} more", DIM))
    private = _private_state_files(root) if whole_tree else []
    if private:
        print(c(f"  PRIVATE -- {len(private)} leftover file(s) under .state/ carry real "
                f"ids, paths or titles and must NOT be in this tree:", AMBER))
        for path, hits in private[: args.limit]:
            note = f"{hits} identifying hit(s)" if hits else "pseudonym -> real session map"
            print(c(f"      {path.relative_to(root)}  ({note})", DIM))
        if len(private) > args.limit:
            print(c(f"      ... {len(private) - args.limit} more", DIM))
        print(c(f"      State belongs at {state}. A daemon started before the move is "
                f"still writing here; restart it:", DIM))
        print(c("      oe supervise --stop && oe supervise --ensure   (then re-run this)", DIM))
        print(c(f"  FAIL: {len(private)} non-shareable file(s) inside the reports tree", RED))
        return 1

    if migrated:
        print(c(f"  FAIL: a session map was inside this tree. It has been moved to "
                f"{state}, but the tree was NOT shareable as handed to this command "
                f"-- re-run to confirm it is now.", RED))
        return 1
    print(c(f"  clean: {clean} artifact(s), 0 findings", GREEN))
    if whole_tree:
        # "clean" is a claim about the whole DIRECTORY now, not just the files
        # listed above: the map that undoes these pseudonyms is not in it. Print
        # where it went so a reader can check that rather than take it on trust.
        print(c(f"  the whole directory is shareable; local state lives outside it, "
                f"at {state}", DIM))
    return 0


def cmd_whois(args) -> int:
    """Pseudonym -> real session, on this machine only."""
    if args.reverse:
        entry = redact_mod.reverse_lookup(args.name)
        if not entry:
            print(c(f"no pseudonym recorded for {args.name}", AMBER), file=sys.stderr)
            return 1
        print(entry.get("pseudonym"))
        return 0
    entry = redact_mod.whois(args.name)
    if not entry:
        print(c(f"unknown pseudonym {args.name!r}; "
                f"the map is {redact_mod.map_path()}", AMBER), file=sys.stderr)
        return 1
    width = max(len(k) for k in entry)
    for key in ("kind", "key", "pseudonym", "title", "project", "project_display",
                "transcript_path", "started_at", "display"):
        if entry.get(key):
            print(f"  {key:<{width}}  {entry[key]}")
    return 0


def _purge_artifacts(root: Path) -> Tuple[int, int]:
    """Delete every generated artifact. Returns (session dirs, loose files).

    Safe because reports are pure derived data: `oe rebuild` regenerates all of
    it from the transcripts. README.md is left alone by construction, not by
    luck -- this only ever removes sessions/* and the two top-level generated
    files. Runtime state is not at risk either way: it lives outside this tree.
    """
    sessions = 0
    loose = 0
    sessions_dir = root / "sessions"
    if sessions_dir.is_dir():
        for entry in sorted(sessions_dir.iterdir()):
            if not entry.is_dir():
                continue
            shutil.rmtree(entry, ignore_errors=True)
            sessions += 1
    for name in ("index.html", "sessions.json"):
        target = root / name
        if target.is_file():
            try:
                target.unlink()
                loose += 1
            except OSError:
                pass
    return sessions, loose


def cmd_rebuild(args) -> int:
    """Purge and regenerate every artifact through the current allowlist.

    Fixing generation is not enough on its own: a session that is never rebuilt
    keeps whatever its last write left on disk, so the old leak would sit in the
    shared directory forever.
    """
    root = paths.reports_root()
    purged_sessions = purged_files = 0
    if args.purge:
        purged_sessions, purged_files = _purge_artifacts(root)
        print(c(f"  purged {purged_sessions} session director(ies) and "
                f"{purged_files} top-level file(s) under {root}", DIM))

    transcripts = list(paths.iter_transcripts())
    if not args.all and args.session:
        transcript = resolve_transcript(args.session)
        transcripts = [transcript] if transcript else []
    transcripts.sort(key=lambda p: -p.stat().st_mtime)

    built = failed = 0
    written_total = 0
    for index, transcript in enumerate(transcripts, 1):
        session_id = transcript.stem
        label = f"[{index}/{len(transcripts)}] {short_sid(session_id)}"
        try:
            written = _write_report(transcript)
            written.pop("ledger", None)
            files = [v for k, v in written.items() if k != "dir"]
            written_total += len(files)
            out_dir = Path(written.get("dir") or paths.session_report_dir(session_id))
            findings = []
            for path in files:
                findings.extend(redact_mod.audit_file(Path(path)))
            bad = [f for f in findings if f.severity == "block"]
            verdict = c("clean", GREEN) if not bad else c(f"{len(bad)} FINDINGS", RED)
            print(f"  {label}  {out_dir.name:<12} {len(files)} files  {verdict}")
            built += 1
            if bad:
                failed += 1
        except Exception as exc:
            print(c(f"  {label}  failed: {exc}", RED), file=sys.stderr)
            failed += 1

    try:
        from oe import dashboard as dashboard_mod
        index_path = dashboard_mod.write_dashboard(root)
        dash_findings = [f for f in redact_mod.audit_file(index_path) if f.severity == "block"]
        dash_findings += [f for f in redact_mod.audit_file(root / "sessions.json")
                          if f.severity == "block"]
        print(f"  dashboard    {index_path.name} + sessions.json  "
              + (c("clean", GREEN) if not dash_findings
                 else c(f"{len(dash_findings)} FINDINGS", RED)))
        written_total += 2
        if dash_findings:
            failed += 1
    except Exception as exc:
        print(c(f"  dashboard skipped: {exc}", AMBER))
        failed += 1

    print(c(f"\n  purged {purged_sessions} sessions, rebuilt {built}, "
            f"{written_total} artifacts written, {failed} with findings or errors", DIM))
    return 1 if failed else 0


# ---------------------------------------------------------------------------
# entrypoint
# ---------------------------------------------------------------------------




# ---------------------------------------------------------------------------
# re-reads, the guard, the context store and the savings view
# ---------------------------------------------------------------------------

# Lazily imported, all three. `oe status` is on the status-line path and must
# not pay for report.py's whole import graph, store.py's sqlite setup or the
# retrieval parser just to print a number; and a partial install (store.py present,
# guard.py not yet) has to degrade to a message rather than an ImportError.
_LAZY: Dict[str, Any] = {}


def _lazy(name: str):
    if name not in _LAZY:
        try:
            import importlib
            _LAZY[name] = importlib.import_module(f"oe.{name}")
        except Exception:
            _LAZY[name] = None
    return _LAZY[name]


def _report():
    module = _lazy("report")
    if module is None:
        raise SystemExit("oe/report.py could not be imported")
    return module


def _store():
    return _lazy("store")


def _guard():
    return _lazy("guard")


def _reread_scope(args) -> Tuple[Dict[str, Any], str]:
    """(analysis, label). One session, or every transcript merged.

    `--all` merges per-session analyses rather than pooling the events, because
    a file read in two sessions was read into two different context windows and
    the second one is not waste. merge_rereads() states the cross-session view
    separately so both numbers are available and neither can be quoted as the
    other.
    """
    if getattr(args, "all", False):
        parts = []
        count = 0
        for transcript in paths.iter_transcripts():
            try:
                led = ledger_mod.load(transcript)
            except Exception:
                continue
            block = led.reread_analysis(limit=0)
            if block.get("reads"):
                parts.append(block)
            count += 1
        return ledger_mod.merge_rereads(parts), f"{count} transcripts"
    transcript = resolve_transcript(getattr(args, "session", None))
    if transcript is None:
        return {}, ""
    led = ledger_mod.load(transcript)
    return led.reread_analysis(limit=0), short_sid(led.session_id)


_REASON_LABEL = {
    "first": "first read",
    "subagent": "other window",
    "post_compact": "after compact",
    "new_range": "new lines",
    "changed": "file changed",
    "avoidable": "AVOIDABLE",
}



def cmd_shrink(args) -> int:
    """What each read cost, against what this machine's index could have printed."""
    shrink_mod = _lazy("shrink")
    if shrink_mod is None:
        # _lazy() swallows the ImportError, so without this the command would
        # simply print nothing and exit 0 -- indistinguishable from "no reads".
        print("oe shrink needs oe/shrink.py, which this install does not have.",
              file=sys.stderr)
        return 2

    events: List[Dict[str, Any]] = []
    if getattr(args, "all", False):
        count = 0
        for transcript in paths.iter_transcripts():
            try:
                events.extend(ledger_mod.load(transcript).reread_events())
            except Exception:
                continue
            count += 1
        label = f"{count} transcripts"
    else:
        transcript = resolve_transcript(getattr(args, "session", None))
        if transcript is None:
            return 1
        led = ledger_mod.load(transcript)
        events = led.reread_events()
        label = short_sid(led.session_id)
    if not events:
        print("no file reads found for that selector")
        return 1

    res = shrink_mod.analyse(events, measured=bool(getattr(args, "measured", False)),
                             limit=int(getattr(args, "limit", 12) or 12))
    res["scope"] = label
    if getattr(args, "json", False):
        # redact_shrink takes a Redactor so its path tokens match the ones
        # redact_rereads mints for the same file; _emit_json passes only the
        # payload, so the Redactor is bound here.
        print(json.dumps(
            _emit_json(res, lambda block: redact_mod.redact_shrink(
                block, redact_mod.Redactor())),
            indent=2, default=str))
        return 0

    width, _h = term_size()
    width = min(width, 100)
    base = retrieval_base()
    print()
    print(shrink_mod.render(
        res, width=width, money=money,
        # clip_left, never clip: it scrubs BEFORE trimming, and every path rule
        # is anchored on the left. See its docstring for the leak this avoids.
        shorten=lambda path: clip_left(path, max(24, width - 40)),
        rule=lambda w, text="": rule(w, f" {text}  {label} "),
        dim=lambda text: c(text, DIM)))
    print()
    return 0


def retrieval_base() -> str:
    ret = _lazy("retrieval")
    try:
        return ret.path_base() if ret else ""
    except Exception:
        return ""


def cmd_rereads(args) -> int:
    block, label = _reread_scope(args)
    if not block or not block.get("reads"):
        print("no file reads found for that selector")
        return 1
    if getattr(args, "json", False):
        # files_ranked[].path is a real path, and scrubbing the home prefix to
        # '~' leaves the interesting half intact: '~/notes/build-cache-not-warm.md'
        # is the shape of the problem -- the basename is the part that names the
        # work, and it survives every path rule. The report replaces the whole
        # path with a shape token via redact_rereads(); so does the pipe.
        print(json.dumps(
            _emit_json(block, lambda b: redact_mod.redact_rereads(b, redact_mod.Redactor())),
            indent=2, default=str))
        return 0

    width, _height = term_size()
    money_key = "carry" if getattr(args, "measured", False) else "calibrated"
    print()
    print(rule(width, f" re-read ledger  {label} "))
    print(f"  {block['reads']:,} reads of {block['files']:,} distinct files, "
          f"{humanize_tokens(block['tokens'])} tokens "
          f"({block['bytes']:,} bytes into context)")
    print(f"  {block['repeat_reads']:,} repeats = "
          f"{block['repeat_pct']:.1f}% of bytes, {block['repeat_pct_calls']:.1f}% of calls")
    if block.get("corpus_repeat_pct"):
        print(f"  cross-session view: {block['corpus_repeat_pct']:.1f}% of bytes are a "
              f"repeat of a file some earlier session had already opened "
              f"({money(block.get('corpus_repeat_calibrated_usd'))})")
    print()
    print(f"  repeat cost   {money(block['repeat_calibrated_usd']):>10s} calibrated "
          f"@ ${block['carry_rate_usd_per_1k_calibrated']:.3f}/1k"
          f"   {money(block['repeat_carry_usd']):>10s} measured "
          f"@ ${block['carry_rate_usd_per_1k_measured']:.4f}/1k")
    print(f"  of which avoidable  {money(block['avoidable_calibrated_usd']):>10s} calibrated"
          f"   {money(block['avoidable_carry_usd']):>10s} measured"
          f"   ({block['avoidable_reads']:,} calls)")
    print(f"  mean carriers per read: {block['carry_requests_mean']:.1f} requests")
    print()

    print(f"  {'reason':<15s} {'calls':>7s} {'bytes':>12s} {'calibrated':>11s} "
          f"{'measured':>10s}")
    print("  " + "-" * 58)
    for row in block.get("by_reason") or []:
        name = row.get("reason") or ""
        tag = _REASON_LABEL.get(name, name)
        colour = "31" if name == "avoidable" else ("32" if name == "first" else "")
        line = (f"  {tag:<15s} {row['reads']:>7,d} {row['bytes']:>12,d} "
                f"{money(row['calibrated_usd']):>11s} {money(row['carry_usd']):>10s}")
        print(c(line, colour) if colour else line)
    print()

    limit = int(getattr(args, "limit", 25) or 25)
    ranked = list(block.get("files_ranked") or [])
    if money_key == "carry":
        # The stored order is by the calibrated figure. --measured has to
        # re-sort, not just re-print: otherwise the column and the ranking
        # disagree and the top row is not the top row.
        ranked.sort(key=lambda r: (-float(r.get("repeat_carry_usd") or 0.0),
                                   -int(r.get("reads") or 0)))
    rows = ranked[:limit]
    path_width = max(24, width - 62)
    print(f"  {'reads':>5s} {'windows':>7s} {'bytes':>11s} {'repeat $':>9s} "
          f"{'avoid $':>8s}  file")
    print("  " + "-" * min(width - 2, 118))
    for row in rows:
        usd = row[f"repeat_{'carry' if money_key == 'carry' else 'calibrated'}_usd"]
        avoid = row[f"avoidable_{'carry' if money_key == 'carry' else 'calibrated'}_usd"]
        print(f"  {row['reads']:>5,d} {row['windows']:>7,d} {row['bytes']:>11,d} "
              f"{money(usd):>9s} {money(avoid):>8s}  "
              f"{clip_left(row['path'], path_width)}")
    if len(ranked) > limit:
        print(f"  ... {len(ranked) - limit:,} more "
              f"(--limit N to see them)")
    print()
    guard_block = block.get("guard") or {}
    print(f"  residency replay: a guard denying reads already resident in the same "
          f"window would have acted on {guard_block.get('would_block', 0):,} calls "
          f"({guard_block.get('correct_blocks', 0):,} correct, "
          f"{guard_block.get('false_blocks', 0):,} false, "
          f"{guard_block.get('false_block_pct', 0.0):.0f}% false-block rate)")
    print()
    return 0


def _guard_state() -> Dict[str, Any]:
    """Everything that decides whether the guard acts, in precedence order."""
    out: Dict[str, Any] = {"available": _guard() is not None}
    if _guard() is None:
        return out
    try:
        cfg = _guard().guard_config()
    except Exception as exc:
        return {"available": True, "error": f"{type(exc).__name__}: {exc}"}
    sentinel = _guard().sentinel_path()
    env = os.environ.get(_guard().ENV_DISABLE)
    effective = cfg.get("mode") or "warn"
    why = "config.json guard.mode"
    # sentinel_active(), not os.path.exists(): the hatch expires, and reporting an
    # expired one as "off" would send the user chasing a switch that is no longer
    # holding anything down.
    ttl = cfg.get("sentinel_ttl_seconds", 14400)
    if _guard().sentinel_active(ttl):
        effective, why = "off", f"sentinel present: {sentinel}"
    if _guard().env_disabled():
        effective, why = "off", f"{_guard().ENV_DISABLE}={env!r}"
    if not cfg.get("enabled", True):
        effective, why = "off", "config.json guard.enabled = false"
    out.update({
        "config_mode": cfg.get("mode"),
        "effective_mode": effective,
        "decided_by": why,
        "enabled": bool(cfg.get("enabled", True)),
        "env": env,
        "sentinel": sentinel,
        "sentinel_present": os.path.exists(sentinel),
        "tools": cfg.get("tools"),
        "min_tokens": cfg.get("min_tokens"),
        "config": cfg,
    })
    return out


def _guard_events() -> Dict[str, Any]:
    """What the guard has actually done, from the store's event log."""
    out = {"deny": 0, "warn": 0, "allow": 0, "saved_tokens": 0}
    if _store() is None:
        return out
    try:
        conn = _store().open_db()
        for kind, count, saved in conn.execute(
                "SELECT kind, COUNT(*), COALESCE(SUM(saved_tokens),0) FROM events "
                "WHERE kind LIKE 'guard_%' GROUP BY kind"):
            out[str(kind).replace("guard_", "")] = int(count)
            out["saved_tokens"] += int(saved)
    except Exception:
        pass
    return out


def _set_guard_mode(mode: str) -> int:
    """Write guard.mode into OUR config.json. Never settings.json."""
    path = paths.CONFIG_PATH
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(raw, dict):
            raw = {}
    except FileNotFoundError:
        raw = {}
    except Exception as exc:
        print(f"  cannot parse {path}: {exc}", file=sys.stderr)
        return 2
    block = raw.get("guard")
    if not isinstance(block, dict):
        block = {}
    before = block.get("mode")
    block["mode"] = mode
    if mode != "off":
        block["enabled"] = True
    raw["guard"] = block
    paths.atomic_write(path, json.dumps(raw, indent=2, ensure_ascii=False) + "\n")
    print(f"  guard.mode {before!r} -> {mode!r} in {path}")
    if mode == "off":
        print("  (the sentinel file and OE_GUARD=off remain independent hatches)")
    else:
        state = _guard_state()
        if state.get("effective_mode") == "off":
            print(f"  ! still effectively OFF: {state.get('decided_by')}")
    return 0


def _hook_installed(event: str, script: str) -> bool:
    try:
        raw = json.loads((paths.CLAUDE_HOME / "settings.json").read_text(encoding="utf-8"))
        for group in (raw.get("hooks") or {}).get(event) or []:
            for entry in (group or {}).get("hooks") or []:
                if script in str((entry or {}).get("command") or ""):
                    return True
    except Exception:
        pass
    return False


def cmd_savings(args) -> int:
    if getattr(args, "all", False):
        block, label = _reread_scope(args)
        payload, opportunities = _savings_corpus_payload()
    else:
        transcript = resolve_transcript(getattr(args, "session", None))
        if transcript is None:
            print("no session found")
            return 1
        led = ledger_mod.load(transcript)
        payload = redact_mod.redact_payload(led.to_dict())
        block = payload.get("rereads") or {}
        label = short_sid(led.session_id)
        opportunities = None
    context = _savings_context()
    levers = _report().savings_levers(payload, rereads=block, context=context,
                                   opportunities=opportunities)
    if getattr(args, "json", False):
        print(json.dumps({"levers": levers, "context": context}, indent=2, default=str))
        return 0

    width, _h = term_size()
    print()
    print(rule(width, f" savings  {label} "))
    combined = _report().combined_saving(levers)
    total = combined["after_groups"]
    spend = float((payload.get("totals") or {}).get("cost_usd") or 0.0)
    print(f"  measured spend in scope  {money(spend)}")
    print(f"  levers not yet taken     {money(total)}")
    if combined["naive_sum"] - total > 0.01:
        print(f"  (adding every row gives {money(combined['naive_sum'])}, but rows sharing a "
              f"group monetise the same tokens; the largest in each group is counted once)")
    print()
    tint = {"active": "32", "partial": "33", "available": "36", "rejected": "90"}
    for row in levers:
        status = str(row.get("status"))
        # NOT private(): a lever title is this tool's own text, not the user's.
        # Almost all of them are string literals in oe/report.py; the one that is
        # not interpolates `agent_type`, which the artifact allowlist already
        # ships in expensive_agents[] and agent_type_costs[], so hiding it here
        # while data.json carries it would be inconsistent as well as unhelpful.
        # The field happens to be called `title`, and private() keys off the
        # CALLER, not the field name -- without this the whole flagship table
        # prints a column of '-' the moment it is piped.
        print(f"  {c(f'{status:<9s}', tint.get(status, ''))} "
              f"{money(row.get('est_usd')):>9s}  {str(row.get('title') or '-')}")
        print(f"            now:  {clip(str(row.get('setting') or '-'), width - 20)}")
        if row.get("change"):
            print(f"            do:   {clip(str(row.get('change')), width - 20)}")
        if getattr(args, "verbose", False):
            print(f"            why:  {clip(str(row.get('basis') or ''), width - 20)}")
            for line in (row.get("evidence") or [])[:3]:
                print(f"                  - {clip(str(line), width - 22)}")
        print()
    print("  active = already switched on   partial = on but not enforcing")
    print("  available = measured, not taken   rejected = measured and not worth it")
    print()
    return 0


def _savings_context() -> Dict[str, Any]:
    """What the transcripts cannot see: settings, MCP deferral, the store, the guard.

    The config half comes from oe/preflight.py rather than from a second copy of
    the same probes here -- `oe preflight` and `oe savings` must never disagree
    about whether the prefix cache is on.
    """
    state = _guard_state()
    context: Dict[str, Any] = {
        "guard_mode": state.get("effective_mode"),
        "guard_decided_by": state.get("decided_by"),
    }
    # The MCP and prefix-cache probes lived in oe/preflight.py, which is not part
    # of v1.0.0. Leaving these keys UNSET is deliberate: report.py skips that
    # lever when prefix_cache is None, whereas defaulting it to "system_prompt"
    # would state a configuration fact nothing had measured. A lever that is
    # silent is recoverable; one that asserts an unmeasured value is not.
    store_facts: Dict[str, Any] = {}
    try:
        store_facts = _store().stats() or {}
    except Exception:
        store_facts = {}
    context["store_indexed"] = bool(int(store_facts.get("files") or 0))
    context["store_files"] = int(store_facts.get("files") or 0)
    context["store_chunks"] = int(store_facts.get("chunks") or 0)
    prefix: Dict[str, Any] = {}
    # preflight.collect() returns measured_first_request as a dict describing the
    # transcript it was measured from, not a bare token count.
    _measured = prefix.get("measured_first_request")
    if isinstance(_measured, dict):
        _measured = _measured.get("fresh_tokens") or _measured.get("tokens") or 0
    try:
        _measured = int(_measured or 0)
    except (TypeError, ValueError):
        _measured = 0
    context["fixed_prefix_tokens"] = (
        _measured
        or int(prefix.get("median_corpus_tokens") or 0)
        or _fixed_prefix_tokens())
    context["compaction_pre_tokens"] = _compaction_pre_tokens()
    return context


def _fixed_prefix_tokens() -> int:
    try:
        rows = _rows()
        best = 0
        for row in rows:
            value = int(row.get("context_tokens") or 0)
            if value and (best == 0 or value < best):
                best = value
        return best
    except Exception:
        return 0


def _compaction_pre_tokens() -> List[int]:
    out: List[int] = []
    try:
        for path in sorted(paths.state_dir().glob("*.compactions.ndjson")):
            for line in path.read_text(encoding="utf-8").splitlines():
                try:
                    row = json.loads(line)
                except Exception:
                    continue
                value = int(row.get("context_tokens") or row.get("preTokens") or 0)
                if value:
                    out.append(value)
    except Exception:
        pass
    return out


def _savings_corpus_payload() -> Tuple[Dict[str, Any], List[Dict[str, Any]]]:
    """Totals and opportunities pooled across every transcript.

    Opportunities are computed per session and summed by id rather than
    recomputed on a merged payload: several of them are non-linear in their
    inputs (the context-cap lever uses a MEDIAN), and a median of medians is
    not a median.
    """
    totals: Dict[str, float] = {}
    by_id: Dict[str, Dict[str, Any]] = {}
    compactions: List[Dict[str, Any]] = []
    # Pooled MAIN-LOOP context series. The compaction lever needs it: without it
    # the corpus view falls back to totals["calls"], which counts every subagent
    # request too, and a subagent does not carry the main window.
    context_series: List[Dict[str, Any]] = []
    window = 0
    model = ""
    for transcript in paths.iter_transcripts():
        try:
            led = ledger_mod.load(transcript)
        except Exception:
            continue
        payload = redact_mod.redact_payload(led.to_dict())
        for key, value in (payload.get("totals") or {}).items():
            if isinstance(value, (int, float)):
                totals[key] = totals.get(key, 0.0) + float(value)
        compactions.extend(payload.get("compactions") or [])
        context_series.extend(payload.get("context_series") or [])
        window = max(window, int((payload.get("context_window") or {}).get("max_tokens") or 0))
        model = model or (payload.get("session") or {}).get("primary_model") or ""
        for row in _report().optimization_opportunities(payload):
            entry = by_id.get(row["id"])
            if entry is None:
                by_id[row["id"]] = dict(row)
            else:
                entry["est_usd"] = float(entry.get("est_usd") or 0.0) + float(row.get("est_usd") or 0.0)
    payload = {"totals": totals, "compactions": compactions,
               "context_series": context_series,
               "context_window": {"max_tokens": window},
               "session": {"primary_model": model},
               "redaction": {"version": 1, "policy": "allowlist"}}
    return payload, sorted(by_id.values(), key=lambda r: -float(r.get("est_usd") or 0.0))


# --------------------------------------------------------------------------
# prune -- the only command in this tool that deletes anything.
# --------------------------------------------------------------------------

# An ALLOWLIST, not a denylist, and that is the whole safety argument. state/
# also holds session-map.json (the pseudonym oracle), accounts.json, the
# settings baselines and the supervisor lock; a rule that said "delete what
# looks old" would eventually reach one of them. Only these shapes are
# per-session scratch that is rebuilt on the next run.
PRUNABLE_SUFFIXES = (".tools.ndjson", ".live.json", ".checkpoint.json",
                     ".injector.json", ".compactions.ndjson", ".watcher.pid")
PRUNABLE_PREFIXES = ("watcher-",)


def _prunable_state(days: int, keep: Sequence[str]) -> List[Dict[str, Any]]:
    """Per-session scratch files older than `days`, excluding live sessions."""
    rows: List[Dict[str, Any]] = []
    cutoff = time.time() - max(1, int(days)) * 86400.0
    try:
        state = paths.state_dir()
    except Exception:
        return rows
    for entry in sorted(state.glob("*")):
        if not entry.is_file():
            continue
        name = entry.name
        ok = any(name.endswith(sfx) for sfx in PRUNABLE_SUFFIXES) or \
            (any(name.startswith(pfx) for pfx in PRUNABLE_PREFIXES) and name.endswith(".log"))
        if not ok:
            continue
        if any(k and k in name for k in keep):
            continue
        try:
            st = entry.stat()
        except OSError:
            continue
        if st.st_mtime >= cutoff:
            continue
        rows.append({"path": str(entry), "bytes": int(st.st_size), "mtime": st.st_mtime})
    return rows


def _live_session_ids() -> List[str]:
    """Session ids this machine is using right now, which prune must not touch."""
    keep = []
    for env in ("CLAUDE_SESSION_ID", "OE_SESSION_ID"):
        value = os.environ.get(env)
        if value:
            keep.append(value)
    try:
        state = paths.state_dir()
        fresh = time.time() - 3600
        for entry in state.glob("*.live.json"):
            if entry.stat().st_mtime >= fresh:
                keep.append(entry.name[:-len(".live.json")])
    except Exception:
        pass
    return sorted(set(k for k in keep if k))


def cmd_prune(args) -> int:
    st = _lazy("store")
    days = max(1, int(args.days))
    keep = _live_session_ids()
    apply_it = bool(args.yes)

    plan = st.prune(days, apply=False, keep_sessions=keep)
    files = _prunable_state(days, keep)
    quar = st.quarantined()
    if not args.quarantine:
        quar = []

    file_bytes = sum(r["bytes"] for r in files)
    quar_bytes = sum(r["bytes"] for r in quar)
    print(c("oe prune", BOLD) + c(f"  -- older than {days} days", DIM))
    if keep:
        print(c(f"  keeping {len(keep)} live session(s): " + ", ".join(k[:8] for k in keep), DIM))
    print(f"  database        {plan['bytes_before'] / 1e6:8.2f} MB   "
          f"{plan['events']:,} events, {plan['ranges']:,} ranges, "
          f"{plan['epochs']:,} closed epochs to drop")
    print(f"  state scratch   {file_bytes / 1e6:8.2f} MB   {len(files)} files")
    if args.quarantine:
        print(f"  quarantined db  {quar_bytes / 1e6:8.2f} MB   {len(quar)} files "
              + c("(healed copies of a corrupt store)", DIM))
    if plan.get("error"):
        print(c("  store error: " + plan["error"], AMBER))

    if not apply_it:
        print()
        print(c("  dry run. nothing was deleted. add --yes to apply.", DIM))
        return 0

    result = st.prune(days, apply=True, keep_sessions=keep)
    removed = 0
    freed = 0
    for row in files + quar:
        try:
            os.unlink(row["path"])
            removed += 1
            freed += row["bytes"]
        except OSError:
            pass
    print()
    print(f"  removed {result['events']:,} events, {result['ranges']:,} ranges, "
          f"{result['epochs']:,} epochs, {removed} files")
    print(f"  database {result['bytes_before'] / 1e6:.2f} -> "
          f"{result['bytes_after'] / 1e6:.2f} MB "
          f"({(result['reclaimed'] + freed) / 1e6:.2f} MB reclaimed in total)")
    if result.get("error"):
        print(c("  store error: " + result["error"], AMBER))
        return 1
    return 0


def _add_privacy_flags(parser: argparse.ArgumentParser) -> None:
    """The PII switch, on the ROOT parser so it applies to every subcommand.

    Default is policy, not a flag: redact whenever stdout is not a terminal.
    These two exist for the cases policy cannot see -- a screen recording of a
    terminal (`--redact`), and piping to a local file you will read yourself
    (`--no-redact`).
    """
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--redact", dest="redact", action="store_const", const=True,
                       default=None,
                       help="redact personal data even on a terminal "
                            "(default: redact whenever stdout is not a terminal)")
    group.add_argument("--no-redact", dest="redact", action="store_const", const=False,
                       help="print full detail even when piped or redirected")


def cmd_package(args) -> int:
    """Build a bundle a colleague can install, and refuse to if it leaks."""
    from oe import package as package_mod

    # The FILE name carries the version; the directory inside the tar does not
    # (package.BUNDLE_NAME). Two downloads in the same folder must be tellable
    # apart, and `tar xzf ... && python3 overwatch-enforcer/install.py` must
    # not need rewriting for every release.
    default_out = Path.home() / package_mod.archive_name()
    out = None if args.dir else Path(args.out or default_out).expanduser()
    result = package_mod.build(out=out, keep_dir=bool(args.dir))

    if args.json:
        print(json.dumps({
            "ok": result.ok,
            "files": len(result.files),
            "leaks": [vars(leak) for leak in result.leaks],
            "allowed_placeholders": result.allowed,
            "dropped_config_keys": sorted(result.dropped_config),
            "archive": str(result.archive) if result.archive else None,
            "sha256": result.sha256,
            "bytes": result.bytes,
        }, indent=2))
        return 0 if result.ok else 1

    width = term_size()[0]
    print(rule(width, "package"))
    print(c(f"  {len(result.files)} file(s) admitted by the allowlist", DIM))
    if args.verbose:
        for rel in result.files:
            print(c(f"      {rel}", DIM))
        for rel in result.skipped:
            print(c(f"      - {rel}", DIM))

    unscanned = (result.drift or {}).get("untracked_by_scan") or []
    ungit = (result.drift or {}).get("unseen_by_git") or []
    if unscanned:
        print(c(f"  {len(unscanned)} file(s) git would commit are not in the allowlist "
                f"-- scanned anyway, but add them to ROOT_FILES/TREES:", AMBER))
        for rel in unscanned[: args.limit]:
            print(c(f"      {rel}", DIM))
        if len(unscanned) > args.limit:
            print(c(f"      ... {len(unscanned) - args.limit} more", DIM))
    if ungit:
        print(c(f"  {len(ungit)} allowlisted file(s) git would NOT publish "
                f"(a clone and a tarball would differ):", AMBER))
        for rel in ungit[: args.limit]:
            print(c(f"      {rel}", DIM))

    if result.dropped_config:
        print(c("  config.json shipped as defaults; local values NOT carried:", DIM))
        for key in sorted(result.dropped_config):
            print(c(f"      {key}", DIM))

    if result.leaks:
        # The samples below are exactly the strings the CLI redactor exists to
        # hide, so on a redacting terminal they arrive as '<user>' and are
        # useless for fixing anything. Say where the real ones are.
        if redact_mod.cli_redaction_enabled():
            print(c("  samples are masked by CLI redaction -- re-run as "
                    "`oe --no-redact package` to read them", DIM))
        identity = [leak for leak in result.leaks if leak.tier == "identity"]
        shape = [leak for leak in result.leaks if leak.tier == "shape"]
        if identity:
            print("  " + c("x", RED) + c(
                f"  {len(identity)} identity hit(s) -- this machine's own "
                f"email/user/host/uuid is in the bundle", RED))
            for leak in identity[: args.limit]:
                print(c(f"      {leak.line()}", DIM))
        if shape:
            print("  " + c("x", RED) + c(
                f"  {len(shape)} unreviewed personal-shaped string(s)", RED))
            for leak in shape[: args.limit]:
                print(c(f"      {leak.line()}", DIM))
            print(c("      If one of these is genuinely a placeholder, add it to "
                    "PLACEHOLDERS in oe/package.py with a reason.", DIM))
        print(c("  FAIL: no archive written", RED))
        return 1

    if result.allowed:
        total = sum(result.allowed.values())
        print(c(f"  {total} personal-shaped string(s) matched reviewed "
                f"placeholders", DIM))
        if args.verbose:
            for reason, count in sorted(result.allowed.items()):
                print(c(f"      {count:>3}  {reason}", DIM))

    print("  " + c("clean", GREEN) + c(
        "  no identity of this machine, no state/, no reports", DIM))
    if result.archive:
        size = f"{result.bytes / 1024:.0f}K" if result.bytes < 1 << 20 \
            else f"{result.bytes / (1 << 20):.1f}M"
        print(f"  {result.archive}  " + c(f"({size})", DIM))
        print(c(f"  sha256 {result.sha256}", DIM))
        print(c(f"  they install with:  tar xzf {result.archive.name} && "
                f"python3 {package_mod.BUNDLE_NAME}/install.py", DIM))
    else:
        print(f"  {result.staged}")
    return 0


def cmd_repair(args) -> int:
    """Run bin/oe-repair as a SUBPROCESS, and never as an import.

    The whole value of oe-repair is that it depends on nothing: no oe/ package,
    no config, no state. Importing it here would quietly re-attach it to this
    process -- and to whatever is wrong with this process -- so the one command
    a user runs when the tooling is broken would start failing for the same
    reason the tooling is broken. A subprocess keeps the two apart.

    This subcommand exists only so the script is DISCOVERABLE: `oe --help` now
    names it, which is where someone whose hooks just died actually looks.
    Every flag is forwarded untouched, so `oe repair` and
    `python3 <root>/bin/oe-repair` are the same run. That tool DIAGNOSES ONLY
    in v1.0.0: it accepts --yes, explains why it will not act on it, and writes
    nothing.
    """
    script = os.path.join(INSTALL_ROOT, "bin", "oe-repair")
    if not os.path.exists(script):
        print(c(f"bin/oe-repair is not in this checkout ({script}).", RED),
              file=sys.stderr)
        return 2
    forwarded = list(getattr(args, "repair_args", None) or [])
    # oe-repair writes to the terminal itself, so the stream scrubber that
    # enforces the CLI redaction policy for every other subcommand is not in
    # the path -- it imports nothing from oe/, deliberately, and that includes
    # the redactor. Say so where the policy would otherwise have applied,
    # rather than let a piped `oe repair` look redacted when it is not.
    if _redacting():
        print(c("  note: oe-repair is standalone and prints absolute paths "
                "unredacted -- read it before pasting it anywhere.", DIM),
              file=sys.stderr)
    try:
        completed = subprocess.run([sys.executable, script] + forwarded)
    except OSError as exc:
        print(c(f"could not run {script}: {exc}", RED), file=sys.stderr)
        return 2
    return int(completed.returncode)


def cmd_version(args) -> int:
    """Print the version, and the commit when this install is a checkout.

    Imported here rather than at the top of the file, like `cmd_package`: the
    module shells out to git, and no other command should pay for that import.
    Nothing is printed when git has nothing to say -- a tarball install has no
    `.git`, which is a supported way to run this and not a warning.
    """
    from oe import version as version_mod

    if getattr(args, "json", False):
        found = version_mod.revision()
        print(json.dumps({
            "version": version_mod.VERSION,
            "commit": found[0] if found else None,
            "dirty": found[1] if found else None,
        }, indent=2))
        return 0
    print(version_mod.describe())
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="oe", description="Overwatch Enforcer: token and cost accounting for Claude Code",
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    _add_privacy_flags(parser)
    # Deliberately NOT argparse's own `action="version"`. That one wants the
    # finished string at parser-BUILD time, and building this one shells out
    # to git three times -- a cost every other command would then pay on every
    # single invocation. store_true here, resolved in main() only if it is set.
    parser.add_argument("-V", "--version", dest="show_version", action="store_true",
                        help="print the version (and the commit, in a checkout) and exit")
    sub = parser.add_subparsers(dest="command")

    status = sub.add_parser("status", help="summary of the current session")
    status.add_argument("session", nargs="?", help="session id, id prefix, path, or --last")
    status.add_argument("--last", dest="session", action="store_const", const="--last")
    status.add_argument("--fast", action="store_true", help="tail-only, no full parse")
    status.add_argument("--json", action="store_true")
    status.add_argument("--no-subagents", action="store_true")
    status.add_argument("--all-accounts", action="store_true",
                        help="per-account rollup across every session instead of one session")
    status.set_defaults(func=cmd_status)

    report = sub.add_parser("report", help="build report.html now")
    report.add_argument("session", nargs="?")
    report.add_argument("--last", dest="session", action="store_const", const="--last")
    report.add_argument("--no-subagents", action="store_true")
    report.set_defaults(func=cmd_report)

    path_cmd = sub.add_parser("path", help="print the path of a session's report.html")
    path_cmd.add_argument("session", nargs="?",
                          help="session id, id prefix, path, or --last (default)")
    path_cmd.add_argument("--last", dest="session", action="store_const", const="--last")
    path_cmd.add_argument("--dir", action="store_true",
                          help="print the report directory instead of report.html")
    path_cmd.set_defaults(func=cmd_path)

    open_cmd = sub.add_parser("open", help="open a session's report in a browser")
    open_cmd.add_argument("session", nargs="?",
                          help="session id, id prefix, path, or --last (default)")
    open_cmd.add_argument("--last", dest="session", action="store_const", const="--last")
    open_cmd.add_argument("--no-browser", action="store_true",
                          help="print the path, launch nothing")
    open_cmd.set_defaults(func=cmd_open)

    watch = sub.add_parser("watch", help="live view of every open session")
    watch.add_argument("--interval", type=float, default=2.0)
    watch.add_argument("--inline", action="store_true",
                       help="run the supervisor inside this process (it stops with the view)")
    watch.add_argument("--no-supervisor", action="store_true",
                       help="do not start the background supervisor; show existing data only")
    watch.add_argument("--keys", dest="help_open", action="store_true",
                       help="open with the key/legend pane showing")
    watch.add_argument("--once", action="store_true",
                       help="draw one frame and exit (what a pipe does anyway)")
    watch.add_argument("--account", choices=list(accounts_mod.known_labels()),
                       help="only show sessions for this account label")
    watch.set_defaults(func=cmd_watch)

    dash = sub.add_parser("dashboard", help="rebuild the cross-session dashboard")
    dash.set_defaults(func=cmd_dashboard)

    sessions = sub.add_parser("sessions", help="table of sessions")
    sessions.add_argument("--active", action="store_true")
    sessions.add_argument("--days", type=float)
    sessions.add_argument("--limit", type=int, default=40)
    sessions.add_argument("--json", action="store_true")
    sessions.add_argument("--account", choices=list(accounts_mod.known_labels()),
                          help="only list sessions for this account label")
    sessions.set_defaults(func=cmd_sessions)

    account = sub.add_parser(
        "account", help="label sessions per account and see the split")
    account_sub = account.add_subparsers(dest="account_command")
    account.set_defaults(func=cmd_account, account_command="list")

    acc_list = account_sub.add_parser(
        "list", help="labels, session counts, spend and the provenance breakdown")
    acc_list.add_argument("--account", choices=list(accounts_mod.known_labels()))
    acc_list.add_argument("--json", action="store_true")
    acc_list.set_defaults(func=cmd_account, account_command="list")

    acc_who = account_sub.add_parser(
        "whoami", help="the label of the account logged in right now (never the address)")
    acc_who.set_defaults(func=cmd_account, account_command="whoami")

    acc_ren = account_sub.add_parser(
        "rename", help="rename a label everywhere it is stored "
                       "(labels are allocated, so they start out generic)")
    acc_ren.add_argument("old", help="the label as it is now, e.g. secondary")
    acc_ren.add_argument("new", help="what to call it instead, e.g. work")
    acc_ren.set_defaults(func=cmd_account, account_command="rename")

    for name, verb in (("assign", "set"), ("unassign", "clear")):
        entry = account_sub.add_parser(
            name, help=f"{verb} a hand-made label on the sessions a selector names")
        # Positionals are order-free on purpose: the documented form is
        # `assign <selector> <label>` but `assign <label> <selector>` reads just
        # as naturally, and the two are told apart by VALUE (only 'personal' and
        # 'work' normalise to a label) rather than by position.
        entry.add_argument("target", nargs="*",
                           help=("session id or id prefix"
                                 + (", plus a label (see `oe account list`)"
                                    if name == "assign" else "")))
        entry.add_argument("--before", help="sessions started before YYYY-MM-DD (local)")
        entry.add_argument("--after", help="sessions started on/after YYYY-MM-DD (local)")
        entry.add_argument("--project", help="sessions whose project path is exactly this")
        entry.add_argument("--dry-run", action="store_true",
                           help="print what would change and write nothing")
        entry.set_defaults(func=cmd_account, account_command=name)

    backfill = sub.add_parser("backfill", help="build reports for past transcripts")
    backfill.add_argument("--all", action="store_true")
    backfill.add_argument("--days", type=float)
    backfill.add_argument("--force", action="store_true", help="rebuild even if current")
    backfill.set_defaults(func=cmd_backfill)

    doctor = sub.add_parser("doctor", help="verify the install")
    doctor.add_argument("--no-pricing", action="store_true",
                        help="skip the binary scan (it reads the whole Claude "
                             "Code binary)")
    doctor.add_argument("--settings", help="check a different settings.json (for rehearsals)")
    doctor.add_argument("--install", action="store_true",
                        help="print the INSTALL readiness checklist and exit non-zero "
                             "if this machine is not ready. Writes nothing, and needs "
                             "nothing installed -- run it before install.py.")
    doctor.add_argument("--dir", help="with --install: check this directory instead of "
                                      "the one oe is running from")
    doctor.add_argument("--no-binary-probe", action="store_true",
                        help="with --install: skip reading the Claude Code binary")
    doctor.set_defaults(func=cmd_doctor)

    for name, handler, verb in (("install-statusline", cmd_install_statusline, "add"),
                                ("uninstall-statusline", cmd_uninstall_statusline, "remove")):
        entry = sub.add_parser(
            name, help=f"{verb} the OPTIONAL in-window status line "
                       "(the only settings.json change this tool makes)")
        entry.add_argument("--yes", action="store_true",
                           help="actually write settings.json; without it this is a dry run "
                                "that only prints the diff")
        entry.add_argument("--settings", default=str(paths.CLAUDE_HOME / "settings.json"),
                           help="operate on a different settings file (use a copy to rehearse)")
        entry.add_argument("--no-backup", action="store_true", help="skip the .bak copy")
        if verb == "add":
            entry.add_argument("--force", action="store_true",
                               help="replace a statusLine that belongs to something else")
        entry.set_defaults(func=handler)

    supervise = sub.add_parser(
        "supervise", help="start / inspect / stop the background supervisor")
    supervise.add_argument("--ensure", action="store_true",
                           help="start one only if none is running (the default, and "
                                "what the shell-rc line calls)")
    supervise.add_argument("--status", action="store_true", help="print its status as JSON")
    supervise.add_argument("--stop", action="store_true", help="stop the running supervisor")
    supervise.add_argument("--quiet", "-q", action="store_true", help="say nothing")
    supervise.set_defaults(func=cmd_supervise)

    autostart = sub.add_parser(
        "autostart", help="OPTIONAL. Manage the one-line ~/.zshrc block that starts "
                          "the supervisor at login (never touches settings.json)")
    autostart.add_argument("--install", action="store_true",
                           help="append the delimited block, idempotently")
    autostart.add_argument("--remove", action="store_true", help="cut the block back out")
    autostart.add_argument("--status", action="store_true",
                           help="report what is installed (the default)")
    autostart.add_argument("--rc", help="operate on a different rc file (use a copy to rehearse)")
    autostart.add_argument("--no-backup", action="store_true",
                           help="skip the numbered .overwatch-enforcer-bak-N copy")
    autostart.set_defaults(func=cmd_autostart)

    prune = sub.add_parser(
        "prune", help="delete residency, events and per-session scratch older "
                      "than N days, then VACUUM (dry run unless --yes)")
    prune.add_argument("--days", type=int, default=45,
                       help="retention window in days (default: 45). Events are the "
                            "evidence `oe savings` reads, so keep "
                            "this wider than the period you want to measure.")
    prune.add_argument("--yes", action="store_true",
                       help="actually delete. Without it this only counts.")
    prune.add_argument("--quarantine", action="store_true",
                       help="also remove *.corrupt-* databases a previous self-heal "
                            "moved aside")
    prune.set_defaults(func=cmd_prune)

    reprice = sub.add_parser("reprice", help="re-extract pricing from the CC binary")
    reprice.add_argument("--binary")
    reprice.set_defaults(func=cmd_reprice)

    audit = sub.add_parser("audit", help="scan the written reports for personal data")
    audit.add_argument("session", nargs="?", help="session id or prefix; omit for --all")
    audit.add_argument("--all", action="store_true", help="every artifact in the tree")
    audit.add_argument("-v", "--verbose", action="store_true",
                       help="also list the ticket-shaped false positives")
    audit.add_argument("--limit", type=int, default=10,
                       help="findings printed per file")
    audit.set_defaults(func=cmd_audit)

    whois = sub.add_parser("whois", help="map a report pseudonym back to a real session")
    whois.add_argument("name", help="a pseudonym (session_07), or a session id with --reverse")
    whois.add_argument("--reverse", action="store_true",
                       help="given a real session id, print its pseudonym")
    whois.set_defaults(func=cmd_whois)

    rebuild = sub.add_parser("rebuild", help="regenerate every report through the allowlist")
    rebuild.add_argument("session", nargs="?")
    rebuild.add_argument("--all", action="store_true", help="every transcript")
    rebuild.add_argument("--purge", action="store_true",
                         help="delete the existing artifacts first (never the README; "
                              "state lives outside this tree)")
    rebuild.set_defaults(func=cmd_rebuild)

    # Context index: retrieval (find/slice/deps/index), the SessionStart
    # preflight, and the MEMORY.md audit. Registered from their own modules so
    # this shared file carries a few lines rather than a hundred; all three
    # import their heavy deps lazily, so a plain `oe status` never pays for them.
    for _name in ("retrieval", "preflight", "memaudit"):
        try:
            _mod = __import__("oe." + _name, fromlist=[_name])
            _mod.register(sub)
        except Exception:
            pass

    # -- the cache/context half of the tool ---------------------------------
    rereads = sub.add_parser(
        "rereads", help="which files were read again, why, and what it cost")
    rereads.add_argument("session", nargs="?",
                         help="session id, id prefix, path, or --last (default)")
    rereads.add_argument("--last", dest="session", action="store_const", const="--last")
    rereads.add_argument("--all", action="store_true",
                         help="every transcript, merged per session")
    rereads.add_argument("--limit", type=int, default=25, help="file rows to print")
    rereads.add_argument("--measured", action="store_true",
                         help="rank and print this session's own carry cost instead of "
                              "the corpus-calibrated rate")
    rereads.add_argument("--json", action="store_true")
    rereads.set_defaults(func=cmd_rereads)

    shrink = sub.add_parser(
        "shrink", help="what each read cost against what the index could have printed")
    shrink.add_argument("session", nargs="?",
                        help="session id, id prefix, path, or --last (default)")
    shrink.add_argument("--last", dest="session", action="store_const", const="--last")
    shrink.add_argument("--all", action="store_true", help="every transcript")
    shrink.add_argument("--limit", type=int, default=12, help="file rows to print")
    shrink.add_argument("--measured", action="store_true",
                        help="price from this session's own request stream instead of "
                             "the corpus-calibrated rate")
    shrink.add_argument("--json", action="store_true")
    shrink.set_defaults(func=cmd_shrink)

    savings = sub.add_parser(
        "savings", help="every lever, measured on your data, ranked by dollars")
    savings.add_argument("session", nargs="?")
    savings.add_argument("--last", dest="session", action="store_const", const="--last")
    savings.add_argument("--all", action="store_true", help="every transcript")
    savings.add_argument("-v", "--verbose", action="store_true",
                         help="print the arithmetic and the evidence for each lever")
    savings.add_argument("--json", action="store_true")
    savings.set_defaults(func=cmd_savings)
    package = sub.add_parser(
        "package", help="build a shareable bundle; refuses to if it would leak")
    package.add_argument("--out",
                         help="archive path (default ~/overwatch-enforcer-<version>.tar.gz)")
    package.add_argument("--dir", action="store_true",
                         help="leave a staged directory instead of an archive")
    package.add_argument("--limit", type=int, default=12,
                         help="findings printed per tier")
    package.add_argument("-v", "--verbose", action="store_true",
                         help="list every file and every accepted placeholder")
    package.add_argument("--json", action="store_true")
    package.set_defaults(func=cmd_package)

    repair = sub.add_parser(
        "repair", add_help=False,
        help="diagnose (--yes: repair) the hook registrations in settings.json")
    # add_help=False so `oe repair --help` reaches oe-repair's OWN help rather
    # than this three-line forwarder's. The forwarder has no options of its
    # own, so there is nothing here for -h to describe.
    # REMAINDER, not individual flags: this is a thin forwarder and duplicating
    # oe-repair's option list here would let the two drift, which for a rescue
    # tool means `oe repair --all` and `oe-repair --all` could one day mean
    # different things.
    repair.add_argument("repair_args", nargs=argparse.REMAINDER,
                        help="passed through to bin/oe-repair (try --help)")
    repair.set_defaults(func=cmd_repair)

    version_cmd = sub.add_parser(
        "version", help="print the version, and the commit if this is a checkout")
    version_cmd.add_argument("--json", action="store_true")
    version_cmd.set_defaults(func=cmd_version)
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv:
        argv = ["status"]
    # --redact / --no-redact must be honoured even when the rest of the command
    # line is malformed, because parse_args() can exit with an error message
    # that itself quotes a path.
    if "--no-redact" in argv:
        redact_mod.set_cli_redaction(False)
    elif "--redact" in argv:
        redact_mod.set_cli_redaction(True)
    redact_mod.install_cli_redaction()
    # Consumed above, so they work in either position: `oe --redact sessions`
    # and `oe sessions --redact` both mean the same thing, which is what anyone
    # would expect of a global switch.
    argv = [a for a in argv if a not in ("--redact", "--no-redact")]
    if not argv:
        argv = ["status"]
    # `oe repair ...` is handed over BEFORE argparse sees the rest.
    #
    # It is a forwarder, not a command with options of its own, and the flags
    # it forwards (--yes, --all, --json, --help) are oe-repair's. Routing them
    # through argparse means this parser answers `oe repair --help` with its
    # own usage and rejects anything it does not recognise -- which for a
    # rescue command is exactly the wrong moment to argue about syntax. The
    # subparser is still registered so that `oe --help` lists it.
    if argv[0] == "repair":
        return cmd_repair(argparse.Namespace(repair_args=argv[1:]))
    args = parser.parse_args(argv)
    # Before the no-subcommand branch: `oe --version` has no subcommand, and
    # falling through to print_help() is not what anyone typing it wants.
    if getattr(args, "show_version", False):
        return cmd_version(args)
    if not hasattr(args, "func"):
        parser.print_help()
        return 0
    try:
        return args.func(args)
    except BrokenPipeError:
        os._exit(0)
    except KeyboardInterrupt:
        print()
        return 130


if __name__ == "__main__":
    sys.exit(main())
